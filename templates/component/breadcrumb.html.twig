{% if items|length >= 3 %}
	<ol class="tarmac-breadcrumb" aria-label="breadcrumbs">
		{% for item in items %}
			<li{% if loop.last %} class="is-current"{% endif %}>
				{% if item.translatedLabel == 'home' %}
					<a href="{{ item.url }}" aria-label="{{ 'home'|trans }}">
						<i class="ti ti-home"></i>
					</a>
				{% elseif item.url and not loop.last %}
					<a href="{{ item.url }}">{{ item.translatedLabel }}</a>
				{% else %}
					{{ item.translatedLabel }}
				{% endif %}
			</li>
		{% endfor %}
	</ol>
{% endif %}
