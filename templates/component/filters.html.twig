{% form_theme form 'form/tags.html.twig' %}

{% set style = style ?? 'default' %}
{% set defaults = form.vars.defaults ?? {} %}

{# Collect all filter data (including defaults) for exports #}
{% set filterData = {} %}
{% for filter in form %}
	{# Use filter.vars.value (view data) if filter.vars.data (normalized data) is empty #}
	{% set value = filter.vars.data is not empty ? filter.vars.data : filter.vars.value %}
	{% if value is not empty %}
		{# Convert DateTimeInterface objects (DateTime / DateTimeImmutable) to ISO strings #}
		{% if value is instanceof('\\DateTimeInterface') %}
			{% set value = value | date('Y-m-d\\TH:i:sP') %}
			{# Handle Enum objects - convert to their value #}
		{% elseif value is instanceof('\\UnitEnum') %}
			{% set value = value.value %}
			{# Handle nested arrays (like date ranges) - convert DateTimeInterface objects #}
		{% elseif value is iterable and not (value.id is defined) %}
			{# Check if it's a simple array (like status[]) or associative array (like date range) #}
			{% if value is iterable and value|keys|first == 0 %}
				{# Simple array - keep as array for URL parameters #}
				{% set convertedValue = [] %}
				{% for val in value %}
					{% if val is instanceof('\\DateTimeInterface') %}
						{% set convertedValue = convertedValue|merge([val | date('Y-m-d\\TH:i:sP')]) %}
					{% elseif val is not empty %}
						{% set convertedValue = convertedValue|merge([val]) %}
					{% endif %}
				{% endfor %}
				{% set value = convertedValue %}
			{% else %}
				{# Associative array (like date range) #}
				{% set convertedValue = {} %}
				{% for key, val in value %}
					{% if val is instanceof('\\DateTimeInterface') %}
						{% set convertedValue = convertedValue | merge({(key): val | date('Y-m-d\\TH:i:sP')}) %}
					{% elseif val is not empty %}
						{% set convertedValue = convertedValue | merge({(key): val}) %}
					{% endif %}
				{% endfor %}
				{% set value = convertedValue %}
			{% endif %}
			{# Convert entity objects to their IDs (must be after iterable check to avoid treating entities as iterables) #}
		{% elseif value.id is defined and value.id is not empty %}
			{% set value = value.id %}
		{% endif %}
		{% set filterData = filterData | merge({(filter.vars.name): value}) %}
	{% endif %}
{% endfor %}

{# Count active filters #}
{% set activeFiltersCount = 0 %}
{% for filter in form %}
	{% set hasData = false %}
	{% if filter.vars.data is instanceof('\\UnitEnum') %}
		{% set hasData = true %}
	{% elseif filter.vars.data is not empty and filter.vars.data is not iterable %}
		{% set hasData = true %}
	{% elseif filter.vars.data is iterable %}
		{% for child in filter.vars.data %}
			{% if child is not empty %}
				{% set hasData = true %}
			{% endif %}
		{% endfor %}
	{% endif %}
	{% if hasData %}
		{% set activeFiltersCount = activeFiltersCount + 1 %}
	{% endif %}
{% endfor %}

<div class="tarmac-filters{% if style == 'small' %} tarmac-filters--sm{% endif %}" data-controller="filter-offcanvas">

	{# Active filter chips (cachés sur mobile pour économiser l'espace) #}
	<div class="d-none d-sm-flex align-items-center" style="gap:0.5rem;flex-wrap:wrap;flex:1;min-width:0;">
		{% for filter in form %}
			{% set hasData = false %}
			{% if filter.vars.data is instanceof('\\UnitEnum') %}
				{% set hasData = true %}
			{% elseif filter.vars.data is not empty and filter.vars.data is not iterable %}
				{% set hasData = true %}
			{% elseif filter.vars.data is iterable %}
				{% for child in filter.vars.data %}
					{% if child is not empty %}
						{% set hasData = true %}
					{% endif %}
				{% endfor %}
			{% endif %}

			{% if hasData %}
				<span class="tarmac-filters__chip">
					<span><strong>{{ filter.vars.name | trans | capitalize }} :</strong>
					{% if filter.vars.data is instanceof('\\DateTimeInterface') %}
						{{ filter.vars.data | date('d/m/Y') }}
					{% elseif filter.vars.data is iterable %}
						{% if filter.vars.data|keys|first == 0 %}
							{% set items = [] %}
							{% for value in filter.vars.data %}
								{% if value is not empty %}
									{% set items = items|merge([value|trans]) %}
								{% endif %}
							{% endfor %}
							{{ items|join(', ') }}
						{% elseif filter.vars.data.startAt is defined and filter.vars.data.startAt is instanceof('\\DateTimeInterface') and filter.vars.data.endAt is defined and filter.vars.data.endAt is instanceof('\\DateTimeInterface') %}
							Du {{ filter.vars.data.startAt | date('d/m/Y') }} au {{ filter.vars.data.endAt | date('d/m/Y') }}
						{% elseif filter.vars.data.endAt is defined and filter.vars.data.endAt is instanceof('\\DateTimeInterface') %}
							Jusqu'au {{ filter.vars.data.endAt | date('d/m/Y') }}
						{% elseif filter.vars.data.startAt is defined and filter.vars.data.startAt is instanceof('\\DateTimeInterface') %}
							À partir du {{ filter.vars.data.startAt | date('d/m/Y') }}
						{% else %}
							{% set items = [] %}
							{% for value in filter.vars.data %}
								{% if value is not empty %}
									{% set items = items|merge([value|trans]) %}
								{% endif %}
							{% endfor %}
							{{ items|join(', ') }}
						{% endif %}
					{% elseif filter.vars.data is instanceof('\\UnitEnum') %}
						{{ filter.vars.data.getLabel() | trans }}
					{% elseif filter.vars.data is same as(true) %}
						Oui
					{% elseif filter.vars.data is same as(false) %}
						Non
					{% elseif filter.vars.data is instanceof('string') and (filter.vars.data == '1') %}
						Oui
					{% elseif filter.vars.data is instanceof('string') and (filter.vars.data == '0') %}
						Non
					{% elseif filter.vars.data is instanceof('string') %}
						{{ filter.vars.data | trans }}
					{% else %}
						{{ filter.vars.data }}
					{% endif %}
					</span>

					{# Construire l'URL de retrait du filtre #}
					{% set routeParams = app.request.attributes.get('_route_params') %}
					{% set queryParams = app.request.query.all %}
					{% set isArrayFilter = filter.vars.data is iterable and filter.vars.data|keys|first == 0 %}

					{% set cleanedRouteParams = {} %}
					{% for key, value in routeParams %}
						{% if value is instanceof('\\UnitEnum') %}
							{% set cleanedRouteParams = cleanedRouteParams | merge({(key): value.value}) %}
						{% else %}
							{% set cleanedRouteParams = cleanedRouteParams | merge({(key): value}) %}
						{% endif %}
					{% endfor %}

					{% set cleanedQueryParams = {} %}
					{% for key, value in queryParams %}
						{% if key != filter.vars.name %}
							{% if value is instanceof('\\UnitEnum') %}
								{% set cleanedQueryParams = cleanedQueryParams | merge({(key): value.value}) %}
							{% elseif value is iterable and not (value.id is defined) %}
								{% set cleanedQueryParams = cleanedQueryParams | merge({(key): value}) %}
							{% else %}
								{% set cleanedQueryParams = cleanedQueryParams | merge({(key): value}) %}
							{% endif %}
						{% endif %}
					{% endfor %}

					{% set baseUrl = path(app.request.attributes.get('_route'), cleanedRouteParams|merge(cleanedQueryParams)) %}
					{% set separator = '?' in baseUrl ? '&' : '?' %}
					{% if isArrayFilter %}
						<a href="{{ baseUrl }}{{ separator }}{{ filter.vars.name }}[]=" class="tarmac-filters__chip-close" aria-label="Retirer le filtre {{ filter.vars.name | trans }}">
							<i class="ti ti-x"></i>
						</a>
					{% else %}
						<a href="{{ baseUrl }}{{ separator }}{{ filter.vars.name }}=" class="tarmac-filters__chip-close" aria-label="Retirer le filtre {{ filter.vars.name | trans }}">
							<i class="ti ti-x"></i>
						</a>
					{% endif %}
				</span>
			{% endif %}
		{% endfor %}

		{% if activeFiltersCount == 0 %}
			<span class="tarmac-filters__empty">Aucun filtre actif</span>
		{% endif %}
	</div>

	<span class="tarmac-filters__spacer d-none d-sm-block"></span>

	<button type="button" class="tarmac-filters__btn ms-auto ms-sm-0" data-bs-toggle="offcanvas" data-bs-target="#offCanvasFilters">
		<i class="ti ti-filter"></i>
		Filtrer
		{% if activeFiltersCount > 0 %}
			<span class="tarmac-filters__btn-badge">{{ activeFiltersCount }}</span>
		{% endif %}
	</button>

	{# Offcanvas — Bootstrap conserve son markup (lié à offcanvas JS) #}
	<div class="offcanvas offcanvas-end" id="offCanvasFilters" tabindex="-1">
		<div class="offcanvas-header">
			<h5 class="offcanvas-title">Filtrer</h5>
			<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
		</div>
		<div class="offcanvas-body">
			{{ form_start(form) }}
			{{ form_rest(form) }}

			<div class="mb-3">
				<div class="row">
					<div class="col-12 col-md-6">
						<button class="btn btn-primary w-100">
							<i class="ti ti-search me-2"></i>
							Filtrer
						</button>
					</div>
					<div class="col-12 col-md-6">
						{% set cleanRouteParams = {} %}
						{% for key, value in app.request.attributes.get('_route_params') %}
							{% if value is instanceof('\\UnitEnum') %}
								{% set cleanRouteParams = cleanRouteParams | merge({(key): value.value}) %}
							{% else %}
								{% set cleanRouteParams = cleanRouteParams | merge({(key): value}) %}
							{% endif %}
						{% endfor %}
						<a href="{{ path(app.request.attributes.get('_route'), cleanRouteParams) }}" class="btn btn-outline-secondary w-100">
							<i class="ti ti-x me-2"></i>
							Effacer
						</a>
					</div>
				</div>
			</div>
			{{ form_end(form) }}
		</div>
	</div>
</div>
