{#
    Task Card Component — charte Tarmac (cf. /design-lab)

    Paramètres :
    - task: l'entité Task à afficher
#}
{% set isCancelled = task.status == 'cancelled' %}
{% set isWaitingApproval = task.isWaitingForApproval %}

<div class="col-12 col-lg-6 mb-3 d-flex">
	<a href="{{ path('club_task_show', {id: task.id}) }}" class="tarmac-card w-100{% if isCancelled %} tarmac-card--dimmed{% endif %}">

		<div class="tarmac-card__head">
			<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
				<i class="ti {{ task.equipment.type.icon }}"></i>
			</span>

			<div class="flex-fill">
				<div class="tarmac-card__eyebrow">{{ task.equipment.name }}</div>
				<h3 class="tarmac-card__title">{{ task.title }}</h3>
				{% if task.dueAt %}
					<div class="tarmac-card__meta">
						<i class="ti ti-calendar"></i>
						{{ task.dueAt|date('d/m/Y') }}
					</div>
				{% endif %}
			</div>

			{# Desktop : badges à droite #}
			<div class="d-none d-md-flex tarmac-card__badges tarmac-card__badges--right" style="margin-top:0;">
				{% if task.isPriorityOrHasPrioritySubTask %}
					<span class="tarmac-badge tarmac-badge--priority">
						<i class="ti ti-flag"></i>
						{{ 'priority'|trans }}
					</span>
				{% endif %}

				{% if isCancelled %}
					<span class="tarmac-badge tarmac-badge--status-cancelled">
						<i class="ti ti-x"></i>
						{{ task.status|trans }}
					</span>
				{% elseif isWaitingApproval %}
					<span class="tarmac-badge tarmac-badge--status-inspection">
						<i class="ti ti-hourglass"></i>
						{{ 'inspectionPending'|trans }}
					</span>
				{% elseif task.status == 'closed' %}
					<span class="tarmac-badge tarmac-badge--status-closed">
						<i class="ti ti-circle-check"></i>
						{{ task.status|trans }}
					</span>
				{% else %}
					<span class="tarmac-badge tarmac-badge--status-open">
						<i class="ti ti-circle"></i>
						{{ task.status|trans }}
					</span>
				{% endif %}

				{% include 'component/difficultyBadge.html.twig' with {'label': task.difficultyLabel, 'color': task.difficultyColor} %}
			</div>
		</div>

		{# Mobile : badges sous le header #}
		<div class="d-flex d-md-none tarmac-card__badges">
			{% if task.isPriorityOrHasPrioritySubTask %}
				<span class="tarmac-badge tarmac-badge--priority">
					<i class="ti ti-flag"></i>
					{{ 'priority'|trans }}
				</span>
			{% endif %}

			{% if isCancelled %}
				<span class="tarmac-badge tarmac-badge--status-cancelled">
					<i class="ti ti-x"></i>
					{{ task.status|trans }}
				</span>
			{% elseif isWaitingApproval %}
				<span class="tarmac-badge tarmac-badge--status-inspection">
					<i class="ti ti-hourglass"></i>
					{{ 'inspectionPending'|trans }}
				</span>
			{% elseif task.status == 'closed' %}
				<span class="tarmac-badge tarmac-badge--status-closed">
					<i class="ti ti-circle-check"></i>
					{{ task.status|trans }}
				</span>
			{% else %}
				<span class="tarmac-badge tarmac-badge--status-open">
					<i class="ti ti-circle"></i>
					{{ task.status|trans }}
				</span>
			{% endif %}

			{% include 'component/difficultyBadge.html.twig' with {'label': task.difficultyLabel, 'color': task.difficultyColor} %}
		</div>

		{# Progress bar + contributeurs — uniquement si la tâche a des sous-tâches #}
		{% if task.subTasks|length > 0 %}
			{% set totalSubTasks = 0 %}
			{% set closed = 0 %}
			{% for subtask in task.subTasks %}
				{% if subtask.status != 'cancelled' %}
					{% set totalSubTasks = totalSubTasks + 1 %}
					{% if subtask.status == 'closed' %}
						{% set closed = closed + 1 %}
					{% endif %}
				{% endif %}
			{% endfor %}
			{% set progress = totalSubTasks > 0 ? (closed / totalSubTasks * 100)|round : 100 %}

			<div class="tarmac-card__footer">
				<div class="tarmac-progress-meta">
					<span><strong>{{ closed }}</strong> / {{ totalSubTasks }} {{ 'subTasks'|trans|lower }}</span>
					<span>{{ progress }} %</span>
				</div>
				<div class="tarmac-progress{% if progress == 100 %} tarmac-progress--done{% endif %}">
					<span style="width: {{ progress }}%"></span>
				</div>
				{% if task.contributors|length > 0 %}
					<div class="d-flex justify-content-end mt-2">
						{% include 'component/contributorAvatars.html.twig' with {'contributors': task.contributors} only %}
					</div>
				{% endif %}
			</div>
		{% endif %}

	</a>
</div>
