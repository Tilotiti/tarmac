{#
    Contributor Avatars Component

    Tight overlapping stack of contributor avatars (matches the landing-page mockup
    aesthetic: saturated gradient circles, white border, bold white initials, +N badge).

    Parameters:
    - contributors: User[] — distinct list of users to display
    - max: int (default 4) — maximum avatars shown before "+N"
    - size: string (default "sm") — "sm" (24px) or "md" (28px)
#}
{% set max = max|default(4) %}
{% set size = size|default('sm') %}

{% if contributors|length > 0 %}
	<div class="contributor-avatars contributor-avatars--{{ size }}" role="list" aria-label="{{ 'contributors'|trans }}">
		{% for user in contributors|slice(0, max) %}
			<span class="contributor-avatar contributor-avatar--c{{ user.id % 8 }}" role="listitem" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ user.fullName|default(user.email) }}">
				{{ user.firstname|default('')|slice(0, 1)|upper }}{{ user.lastname|default('')|slice(0, 1)|upper }}
			</span>
		{% endfor %}
		{% if contributors|length > max %}
			{% set rest = contributors|slice(max) %}
			{% set restNames = [] %}
			{% for user in rest %}
				{% set restNames = restNames|merge([user.fullName|default(user.email)]) %}
			{% endfor %}
			<span class="contributor-avatar contributor-avatar--more" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ restNames|join(', ') }}">
				+{{ contributors|length - max }}
			</span>
		{% endif %}
	</div>
{% endif %}
