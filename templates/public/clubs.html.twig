{% extends 'layout/base.html.twig' %}

{% block title %}Mes clubs
{% endblock %}

{% block navbar_brand %}
	{% include 'component/brandMark.html.twig' with {href: path('public_clubs')} %}
{% endblock %}

{% block body %}
	<div class="page-header d-print-none">
		<div class="container-xl">
			<div class="row g-2 align-items-center">
				<div class="col">
					<span class="tarmac-page-eyebrow" style="cursor:default;">
						<i class="ti ti-home-2"></i>
						{{ 'myAccount'|trans|default('Mon compte') }}
					</span>
					<h2 class="page-title">
						{{ 'myClubs'|trans }}
					</h2>
					<div class="text-secondary mt-1">
						{{ 'helloUser'|trans({name: app.user.firstname ?: app.user.fullName})|default('Bonjour ' ~ app.user.fullName ~ ' !') }}
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="page-body">
		<div class="container-xl">
			{% if clubs|length > 0 %}
				<div class="row g-3">
					{% for club in clubs %}
						{# Palette déterministe : hash du nom → 1 des 6 variantes tarmac-eqv #}
						{% set palette = ['blue', 'green', 'purple', 'orange', 'azure', 'red'] %}
						{% set colorIndex = (club.name|length + club.id) % 6 %}
						{% set color = palette[colorIndex] %}

						{% set stats = clubStats[club.id]|default({openTasks: 0, awaitingInspection: null}) %}

						<div class="col-12 col-md-6 col-lg-4 d-flex">
							<a href="{{ subdomainService.generateClubUrl(club.subdomain, '/') }}"
							   class="tarmac-card w-100"
							   style="display:flex;flex-direction:column;">

								<div class="tarmac-card__head">
									<span class="tarmac-eqv tarmac-eqv--{{ color }}">
										<i class="ti ti-windsock"></i>
									</span>
									<div class="flex-fill" style="min-width:0;">
										<div class="tarmac-card__eyebrow">
											<i class="ti ti-world"></i>
											{{ club.subdomain }}.{{ subdomainService.domain }}
										</div>
										<h3 class="tarmac-card__title" style="overflow:hidden;text-overflow:ellipsis;">
											{{ club.name }}
										</h3>
									</div>
								</div>

								{# Rôles #}
								<div class="tarmac-card__badges" style="margin-top:0.6rem;">
									{% if app.user.isManagerOfClub(club) %}
										<span class="tarmac-badge tarmac-badge--success">
											<i class="ti ti-shield-check"></i>{{ 'manager'|trans|default('Gestionnaire') }}
										</span>
									{% endif %}
									{% if app.user.isInspectorOfClub(club) %}
										<span class="tarmac-badge tarmac-badge--glow">
											<i class="ti ti-eye-check"></i>{{ 'inspector'|trans|default('Qualifié') }}
										</span>
									{% endif %}
									{% if not app.user.isManagerOfClub(club) and not app.user.isInspectorOfClub(club) %}
										<span class="tarmac-badge tarmac-badge--info">
											<i class="ti ti-user"></i>{{ 'member'|trans|default('Membre') }}
										</span>
									{% endif %}
								</div>

								{# Footer stats : pulse du club #}
								<div class="tarmac-card__footer d-flex align-items-center justify-content-between gap-2" style="margin-top:auto;">
									<span class="tarmac-card__meta" title="{{ 'openTasks'|trans }}">
										<i class="ti ti-list-check"></i>
										<strong style="color:var(--td-deep);">{{ stats.openTasks }}</strong>
										<span style="margin-left:0.2rem;">{{ 'openTasks'|trans|lower }}</span>
									</span>
									{% if stats.awaitingInspection is not null and stats.awaitingInspection > 0 %}
										<span class="tarmac-badge tarmac-badge--status-inspection" title="{{ 'subTasksToValidate'|trans }}">
											<i class="ti ti-hourglass"></i>{{ stats.awaitingInspection }}
										</span>
									{% endif %}
								</div>

							</a>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="tarmac-panel" style="text-align:center;padding:3rem 1.5rem;max-width:560px;margin:0 auto;">
					<div style="width:64px;height:64px;border-radius:16px;background:var(--td-cream);color:var(--td-deep);display:inline-flex;align-items:center;justify-content:center;font-size:1.8rem;margin-bottom:1rem;">
						<i class="ti ti-windsock"></i>
					</div>
					<h3 style="font-size:1.15rem;font-weight:700;margin-bottom:0.5rem;">{{ 'noClubAvailable'|trans|default('Aucun club') }}</h3>
					<p class="text-secondary" style="margin:0;">{{ 'noClubDescription'|trans|default("Vous n'avez pas encore accès à un club actif. Contactez votre gestionnaire de club pour obtenir une invitation.") }}</p>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
