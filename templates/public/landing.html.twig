{% extends 'public/base.html.twig' %}

{% block title %}{{ 'home'|trans }}{% endblock %}

{% block body %}
	<div class="container-xl py-4 py-md-6">
		{# Hero #}
		<div class="row align-items-center g-4 mb-5">
			<div class="col-12 col-md-7">
				<div class="d-flex align-items-center mb-3">
					<img src="{{ asset('logo.svg') }}" height="48" alt="Tarmac" class="me-3">
				</div>
				<h1 class="display-6 fw-bold mb-3">
					{{ 'landingHeadline'|trans }}
				</h1>
				<p class="text-secondary fs-3 mb-4">
					{{ 'landingSubheadline'|trans|raw }}
				</p>
				<div class="d-flex flex-column flex-sm-row gap-2">
					<a href="{{ path('public_login') }}" class="btn btn-primary btn-lg" style="min-height: 44px;">
						<i class="ti ti-login me-2"></i>
						{{ 'signIn'|trans }}
					</a>
					<a href="{{ path('public_guide') }}" class="btn btn-outline-primary btn-lg" style="min-height: 44px;">
						<i class="ti ti-book-2 me-2"></i>
						{{ 'discoverGuide'|trans }}
					</a>
				</div>
			</div>
			<div class="col-12 col-md-5 text-center d-none d-md-block">
				<img src="{{ asset('glider.svg') }}" alt="" class="img-fluid" style="max-height: 280px;">
			</div>
		</div>

		{# Features #}
		<div class="row g-3 mb-5">
			<div class="col-12 col-md-4">
				<div class="card card-sm h-100">
					<div class="card-body">
						<div class="d-flex align-items-center mb-2">
							<span class="avatar bg-primary-lt me-2">
								<i class="ti ti-checklist fs-2"></i>
							</span>
							<h3 class="card-title mb-0">{{ 'landingFeaturePlansTitle'|trans }}</h3>
						</div>
						<p class="text-secondary mb-0">
							{{ 'landingFeaturePlansBody'|trans }}
						</p>
					</div>
				</div>
			</div>
			<div class="col-12 col-md-4">
				<div class="card card-sm h-100">
					<div class="card-body">
						<div class="d-flex align-items-center mb-2">
							<span class="avatar bg-green-lt me-2">
								<i class="ti ti-users fs-2"></i>
							</span>
							<h3 class="card-title mb-0">{{ 'landingFeatureCollabTitle'|trans }}</h3>
						</div>
						<p class="text-secondary mb-0">
							{{ 'landingFeatureCollabBody'|trans }}
						</p>
					</div>
				</div>
			</div>
			<div class="col-12 col-md-4">
				<div class="card card-sm h-100">
					<div class="card-body">
						<div class="d-flex align-items-center mb-2">
							<span class="avatar bg-azure-lt me-2">
								<i class="ti ti-history fs-2"></i>
							</span>
							<h3 class="card-title mb-0">{{ 'landingFeatureHistoryTitle'|trans }}</h3>
						</div>
						<p class="text-secondary mb-0">
							{{ 'landingFeatureHistoryBody'|trans }}
						</p>
					</div>
				</div>
			</div>
		</div>

		{# Secondary CTA #}
		<div class="card card-md bg-primary-lt border-0">
			<div class="card-body text-center py-4">
				<h2 class="mb-2">{{ 'landingCtaTitle'|trans }}</h2>
				<p class="text-secondary mb-3">
					{{ 'landingCtaBody'|trans }}
				</p>
				<a href="{{ path('public_guide') }}" class="btn btn-primary" style="min-height: 44px;">
					<i class="ti ti-book-2 me-2"></i>
					{{ 'readUserGuide'|trans }}
				</a>
			</div>
		</div>
	</div>
{% endblock %}
