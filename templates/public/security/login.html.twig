{% extends 'public/base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
	<div class="page page-center">
		<div class="container container-tight py-4">
			<div class="text-center mb-4">
				<a href="{{ path('public_landing') }}" class="navbar-brand navbar-brand-autodark">
					<img src="{{ asset('logo.svg') }}" height="48" alt="Tarmac">
				</a>
			</div>
			<div class="tarmac-panel">
				<h2 style="font-size:1.4rem;font-weight:800;text-align:center;margin:0 0 1.5rem;letter-spacing:-0.015em;">Connexion à votre compte</h2>

				{% if invitation_token is defined and invitation_token %}
					<div class="alert alert-info mb-4">
						<div class="d-flex align-items-start">
							<i class="ti ti-mail me-2" style="font-size:1.2rem;"></i>
							<div>
								<strong>Invitation en attente</strong>
								<p class="mb-0 mt-1" style="font-size:0.88rem;">Connectez-vous pour accepter votre invitation au club.</p>
							</div>
						</div>
					</div>
				{% endif %}

				{% if error %}
					<div class="alert alert-danger" role="alert">
						<div class="d-flex align-items-start">
							<i class="ti ti-alert-circle me-2" style="font-size:1.2rem;"></i>
							<div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
						</div>
					</div>
				{% endif %}

				<form action="{{ path('public_login') }}{% if invitation_token is defined and invitation_token %}?invitation={{ invitation_token }}{% endif %}" method="post" autocomplete="off" data-turbo="false">
					<div class="mb-3">
						<label class="form-label">E-mail</label>
						<input type="email" name="_username" value="{{ last_username }}" class="form-control" placeholder="votre@email.fr" required autocomplete="email"/>
					</div>
					<div class="mb-2">
						<label class="form-label d-flex justify-content-between align-items-center">
							<span>Mot de passe</span>
							<a href="{{ path('public_reset_password_request') }}" tabindex="-1" style="font-size:0.82rem;font-weight:500;">Mot de passe oublié ?</a>
						</label>
						<input type="password" name="_password" class="form-control" placeholder="Votre mot de passe" autocomplete="current-password" required/>
					</div>
					<div class="mb-3">
						<label class="form-check">
							<input type="checkbox" name="_remember_me" class="form-check-input"/>
							<span class="form-check-label">Se souvenir de moi</span>
						</label>
					</div>
					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>
					<button type="submit" class="btn btn-primary w-100" style="min-height: 48px;">
						<i class="ti ti-login me-2"></i>Se connecter
					</button>
				</form>

				<div class="text-center text-secondary mt-3" style="font-size:0.85rem;">
					<a href="{{ path('public_landing') }}" style="color:var(--td-ink-2);">
						<i class="ti ti-arrow-left me-1"></i>Retour à l'accueil
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
