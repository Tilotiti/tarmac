{% extends 'public/base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe{% endblock %}

{% block body %}
	<div class="page page-center">
		<div class="container container-tight py-4">
			<div class="text-center mb-4">
				<a href="{{ path('public_landing') }}" class="navbar-brand navbar-brand-autodark">
					<img src="{{ asset('logo.svg') }}" height="48" alt="Tarmac">
				</a>
			</div>
			<div class="tarmac-panel">
				<h2 style="font-size:1.4rem;font-weight:800;text-align:center;margin:0 0 1.5rem;letter-spacing:-0.015em;">Réinitialiser mon mot de passe</h2>

				{{ form_start(resetForm) }}
				{{ form_row(resetForm.plainPassword) }}

				<button type="submit" class="btn btn-primary w-100 mt-3" style="min-height: 48px;">
					<i class="ti ti-check me-2"></i>Réinitialiser mon mot de passe
				</button>
				{{ form_end(resetForm) }}
			</div>
		</div>
	</div>
{% endblock %}
