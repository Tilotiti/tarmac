{% extends 'public/base.html.twig' %}

{% block title %}Créer votre compte{% endblock %}

{% block body %}
	<div class="page page-center">
		<div class="container container-tight py-4">
			<div class="text-center mb-4">
				<a href="{{ path('public_landing') }}" class="navbar-brand navbar-brand-autodark">
					<img src="{{ asset('logo.svg') }}" height="48" alt="Tarmac">
				</a>
			</div>
			<div class="tarmac-panel">
				<h2 style="font-size:1.4rem;font-weight:800;text-align:center;margin:0 0 1.5rem;letter-spacing:-0.015em;">Bienvenue !</h2>

				{% if invitation is defined %}
					<div class="alert alert-info mb-4">
						<div class="d-flex align-items-start">
							<i class="ti ti-mail me-2" style="font-size:1.2rem;"></i>
							<div>
								<strong>Invitation de {{ invitation.club.name }}</strong>
								<p class="mb-0 mt-1" style="font-size:0.88rem;">
									{% if invitation.fullname %}Bonjour <strong>{{ invitation.fullname }}</strong>,<br>{% endif %}
									Vous avez été invité(e) à rejoindre ce club{% if invitation.rolesText != 'Membre' %} en tant que <strong>{{ invitation.rolesText }}</strong>{% endif %}.
								</p>
							</div>
						</div>
					</div>
				{% endif %}

				<p class="text-center text-secondary mb-4">
					{% if invitation is defined and invitation.isLocked %}
						Vous avez déjà un compte. <a href="{{ loginUrl }}">Connectez-vous pour accepter l'invitation</a>
					{% else %}
						Créez votre compte pour accepter l'invitation
					{% endif %}
				</p>

				{{ form_start(registrationForm) }}
				{{ form_errors(registrationForm) }}
				{{ form_row(registrationForm.plainPassword) }}

				<button type="submit" class="btn btn-primary w-100 mt-3" style="min-height: 48px;">
					<i class="ti ti-check me-2"></i>
					{% if invitation is defined %}Créer mon compte et rejoindre{% else %}Créer mon compte{% endif %}
				</button>
				{{ form_end(registrationForm) }}

				{% if invitation is defined %}
					<div class="text-center mt-3">
						<a href="{{ loginUrl }}" style="color:var(--td-ink-2);font-size:0.85rem;">
							<i class="ti ti-login me-1"></i>Vous avez déjà un compte ? Connectez-vous
						</a>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
