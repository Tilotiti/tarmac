{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ invitation.fullname ? invitation.fullname : invitation.email }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_invitations') }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv" style="background:var(--td-glow-soft);color:var(--td-warning);">
			<i class="ti ti-mail"></i>
		</span>
		{{ 'pendingInvitations'|trans }}
	</a>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-edit-roles">
			<i class="ti ti-edit me-2"></i>
			<span class="d-none d-sm-inline">{{ 'edit'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'edit'|trans }}</span>
		</button>

		<form method="post" action="{{ path('club_invitation_resend', {id: invitation.id}) }}" class="d-inline">
			<button type="submit" class="btn btn-outline-secondary">
				<i class="ti ti-send me-2"></i>
				<span class="d-none d-sm-inline">{{ 'resend'|trans }}</span>
				<span class="d-inline d-sm-none">{{ 'resend'|trans }}</span>
			</button>
		</form>

		<div class="dropdown d-inline-block" data-controller="dropdown">
			<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
				<i class="ti ti-dots-vertical"></i>
			</button>
			<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
				<form method="post" action="{{ path('club_invitation_delete', {id: invitation.id}) }}" onsubmit="return confirm('{{ 'confirmCancelInvitation'|trans }}');">
					<button type="submit" class="dropdown-item text-danger">
						<i class="ti ti-trash me-2"></i>{{ 'cancelInvitation'|trans|default('Annuler l\'invitation') }}
					</button>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

{% block page_content %}
	{% if openModal %}<div data-auto-open-modal="modal-edit-roles"></div>{% endif %}

	<div class="row g-3">
		<div class="col-12 col-lg-8">

			<div class="tarmac-panel mb-3">
				<div class="tarmac-panel__title">
					<i class="ti ti-mail"></i>{{ 'invitationDetails'|trans }}
				</div>

				<ul class="tarmac-meta-list">
					<li>
						<span class="tarmac-meta-list__label">{{ 'email'|trans }}</span>
						<span class="tarmac-meta-list__value">{{ invitation.email }}</span>
					</li>
					{% if invitation.firstname or invitation.lastname %}
						<li>
							<span class="tarmac-meta-list__label">{{ 'fullName'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ invitation.fullname }}</span>
						</li>
					{% endif %}
					<li>
						<span class="tarmac-meta-list__label">{{ 'sentOn'|trans }}</span>
						<span class="tarmac-meta-list__value">{{ invitation.createdAt|date('d/m/Y H:i') }}</span>
					</li>
					<li>
						<span class="tarmac-meta-list__label">{{ 'expiresOn'|trans }}</span>
						<span class="tarmac-meta-list__value">{{ invitation.expiresAt|date('d/m/Y H:i') }}</span>
					</li>
				</ul>
			</div>

			{% if invitation.isLocked %}
				<div class="alert alert-info">
					<div class="d-flex align-items-start">
						<i class="ti ti-lock me-2" style="font-size:1.2rem;"></i>
						<div>
							<strong>{{ 'existingUser'|trans }}</strong>
							<p style="margin:0.3rem 0 0;font-size:0.9rem;">{{ 'existingUserInfo'|trans }}</p>
						</div>
					</div>
				</div>
			{% endif %}

		</div>

		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-user-cog"></i>{{ 'roles'|trans }}
					</div>
					<div class="tarmac-card__badges">
						{% if invitation.isManager %}
							<span class="tarmac-badge tarmac-badge--success"><i class="ti ti-shield"></i>{{ 'manager'|trans }}</span>
						{% endif %}
						{% if invitation.isInspector %}
							<span class="tarmac-badge tarmac-badge--glow"><i class="ti ti-eye-check"></i>{{ 'inspector'|trans }}</span>
						{% endif %}
						{% if not invitation.isManager and not invitation.isInspector %}
							<span class="tarmac-badge tarmac-badge--secondary"><i class="ti ti-user"></i>{{ 'member'|trans }}</span>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>

	{# Modal for editing invitation - inchangé fonctionnellement #}
	<div class="modal modal-blur fade" id="modal-edit-roles" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				{{ form_start(form, {'attr': {'id': 'form-edit-invitation'}}) }}
				<div class="modal-header">
					<h5 class="modal-title">{{ 'editInvitation'|trans }}</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						{{ form_label(form.email) }}
						{{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
						<div class="form-text">{{ 'emailCannotBeChanged'|trans }}</div>
						{{ form_errors(form.email) }}
					</div>

					<div class="row">
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.firstname) }}
							{{ form_widget(form.firstname, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.firstname) }}
						</div>
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.lastname) }}
							{{ form_widget(form.lastname, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.lastname) }}
						</div>
					</div>

					<div class="tarmac-panel" style="padding:0.9rem 1rem;margin-top:1rem;">
						<div class="tarmac-panel__title">{{ 'clubRoles'|trans }}</div>
						{% for field in [form.isManager, form.isInspector] %}
							<div class="mb-3">
								<div class="form-check">
									<input type="checkbox" id="{{ field.vars.id }}" name="{{ field.vars.full_name }}" class="form-check-input" value="1" {% if field.vars.checked %} checked {% endif %}>
									<label class="form-check-label" for="{{ field.vars.id }}">
										<div>{{ field.vars.label|trans }}</div>
										{% if field.vars.help %}
											<div class="text-secondary small">{{ field.vars.help|trans }}</div>
										{% endif %}
									</label>
								</div>
								{{ form_errors(field) }}
							</div>
						{% endfor %}
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'cancel'|trans }}</button>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-check me-2"></i>{{ 'save'|trans }}
					</button>
				</div>
				{% do form.email.setRendered %}
				{% do form.firstname.setRendered %}
				{% do form.lastname.setRendered %}
				{% do form.isManager.setRendered %}
				{% do form.isInspector.setRendered %}
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
