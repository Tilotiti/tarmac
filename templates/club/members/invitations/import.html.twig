{% extends 'club/base.html.twig' %}

{% block page_title %}{{ 'import'|trans }}{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_invitations') }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv" style="background:var(--td-glow-soft);color:var(--td-warning);">
			<i class="ti ti-mail"></i>
		</span>
		{{ 'pendingInvitations'|trans }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-10 mx-auto">
			{% if result is null %}
				{# Upload form #}
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-file-upload"></i>{{ 'selectGivavFile'|trans }}
					</div>

					<div class="tarmac-panel mb-4" style="background: var(--td-info-soft); border-color: rgba(52, 91, 124, 0.25);">
						<div class="d-flex align-items-start gap-2">
							<i class="ti ti-info-circle" style="font-size:1.3rem;color:var(--td-info);"></i>
							<div>
								<strong>{{ 'fileFormatHelp'|trans }}</strong>
								<p style="margin:0.4rem 0;font-size:0.9rem;color:var(--td-ink-2);">{{ 'givavFileDescription'|trans }}</p>
								<p style="margin:0;font-size:0.9rem;color:var(--td-ink);"><strong>{{ 'requiredColumns'|trans }} :</strong> Courriel, Prénom, Nom</p>
							</div>
						</div>
					</div>

					{{ form_start(form, {'attr': {'class': 'form'}}) }}
					<div class="mb-3">{{ form_row(form.file) }}</div>

					<div class="d-flex justify-content-end gap-2 mt-3">
						<a href="{{ path('club_invitations') }}" class="btn btn-outline-secondary">
							<i class="ti ti-arrow-left me-2"></i>{{ 'cancel'|trans }}
						</a>
						<button type="submit" class="btn btn-primary">
							<i class="ti ti-upload me-2"></i>{{ 'uploadFile'|trans }}
						</button>
					</div>
					{{ form_end(form) }}
				</div>
			{% else %}
				{# Results #}
				{% if result.hasErrors %}
					<div class="tarmac-panel mb-3" style="background: var(--td-danger-soft); border-color: rgba(184, 54, 74, 0.3);">
						<div class="tarmac-panel__title" style="color: var(--td-danger);">
							<i class="ti ti-alert-circle"></i>{{ 'importErrors'|trans }}
						</div>
						<ul style="margin:0;">
							{% for error in result.errors %}
								<li>{{ error }}</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{# Success KPI #}
				<div class="row g-2 mb-4">
					<div class="col-12 col-md-6">
						<div class="tarmac-kpi tarmac-kpi--success">
							<span class="tarmac-kpi__icon"><i class="ti ti-mail-check"></i></span>
							<div class="tarmac-kpi__label">{{ 'invitationsCreated'|trans }}</div>
							<div class="tarmac-kpi__value">{{ result.createdCount }}</div>
						</div>
					</div>
					<div class="col-12 col-md-6">
						<div class="tarmac-kpi">
							<span class="tarmac-kpi__icon"><i class="ti ti-mail-off"></i></span>
							<div class="tarmac-kpi__label">{{ 'invitationsSkipped'|trans }}</div>
							<div class="tarmac-kpi__value">{{ result.skippedCount }}</div>
						</div>
					</div>
				</div>

				{# Skipped details #}
				{% if result.skippedCount > 0 %}
					<div class="tarmac-panel mb-3">
						<div class="tarmac-panel__title">
							<i class="ti ti-list-details"></i>{{ 'skippedDetails'|trans }}
						</div>
						<ul class="tarmac-contributors">
							{% for skipped in result.skipped %}
								<li class="tarmac-contributors__item">
									<span class="tarmac-eqv" style="width:32px;height:32px;background:var(--td-neutral-soft);color:var(--td-neutral);font-size:0.85rem;">
										<i class="ti ti-user"></i>
									</span>
									<div class="flex-fill" style="min-width:0;">
										<div style="font-weight:600;font-size:0.92rem;">{{ skipped.identifier }}</div>
										<div class="text-secondary" style="font-size:0.82rem;">{{ skipped.reason|trans }}</div>
									</div>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{# Created invitations #}
				{% if result.createdCount > 0 %}
					<div class="tarmac-panel mb-3">
						<div class="tarmac-panel__title">
							<i class="ti ti-mail-check"></i>{{ 'createdInvitations'|trans }}
						</div>
						<ul class="tarmac-contributors">
							{% for email in result.created %}
								<li class="tarmac-contributors__item">
									<span class="tarmac-eqv" style="width:32px;height:32px;background:var(--td-success-soft);color:var(--td-success);font-size:0.85rem;">
										<i class="ti ti-mail"></i>
									</span>
									<span class="tarmac-contributors__name">{{ email }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				<div class="d-flex gap-2 justify-content-end flex-wrap">
					<a href="{{ path('club_invitations') }}" class="btn btn-outline-secondary">
						<i class="ti ti-arrow-left me-2"></i>{{ 'backToInvitations'|trans }}
					</a>
					<a href="{{ path('club_invitation_import') }}" class="btn btn-primary">
						<i class="ti ti-upload me-2"></i>{{ 'importAnother'|trans }}
					</a>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
