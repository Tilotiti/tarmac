{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'pendingInvitations'|trans }}
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		<a href="{{ path('club_invitation_import') }}" class="btn btn-outline-secondary">
			<i class="ti ti-file-upload me-2"></i>
			<span class="d-none d-sm-inline">{{ 'import'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'import'|trans }}</span>
		</a>
		<a href="{{ path('club_invitation_create') }}" class="btn btn-primary">
			<i class="ti ti-plus me-2"></i>
			<span class="d-none d-sm-inline">{{ 'invite'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'invite'|trans }}</span>
		</a>
	</div>
{% endblock %}

{% block page_content %}
	{% if joinRequests is not empty %}
		<div class="tarmac-panel mb-4">
			<h3 style="font-size:1.05rem;font-weight:700;margin:0 0 0.75rem;"><i class="ti ti-door-enter me-2"></i>{{ 'joinRequests'|trans }}</h3>
			<p class="text-secondary" style="font-size:0.9rem;">{{ 'joinRequestsHint'|trans }}</p>
			<div class="list-group">
				{% for joinRequest in joinRequests %}
					<div class="list-group-item">
						<div class="fw-bold">{{ joinRequest.user.fullName }}</div>
						<div class="text-secondary" style="font-size:0.9rem;"><i class="ti ti-at"></i> {{ joinRequest.user.email }} · {{ joinRequest.createdAt|date('d/m/Y') }}</div>
						{% if joinRequest.message %}<p class="mb-2 mt-1" style="white-space:pre-line;">{{ joinRequest.message }}</p>{% endif %}
						<form method="post" action="{{ path('club_join_request_accept', {id: joinRequest.id}) }}" class="mt-2">
							<input type="hidden" name="_token" value="{{ csrf_token('accept-join-request-' ~ joinRequest.id) }}">
							<div class="text-secondary" style="font-size:0.85rem;margin-bottom:0.35rem;">{{ 'joinRequestRoles'|trans }}</div>
							<div class="d-flex flex-wrap gap-3 mb-2">
								<label class="form-check form-check-inline m-0" style="min-height:44px;align-items:center;display:flex;">
									<input class="form-check-input" type="checkbox" name="isManager" value="1">
									<span class="form-check-label ms-1">{{ 'manager'|trans }}</span>
								</label>
								<label class="form-check form-check-inline m-0" style="min-height:44px;align-items:center;display:flex;">
									<input class="form-check-input" type="checkbox" name="isInspector" value="1">
									<span class="form-check-label ms-1">{{ 'inspector'|trans }}</span>
								</label>
								<label class="form-check form-check-inline m-0" style="min-height:44px;align-items:center;display:flex;">
									<input class="form-check-input" type="checkbox" name="isPilote" value="1">
									<span class="form-check-label ms-1">{{ 'pilot'|trans }}</span>
								</label>
							</div>
							<div class="d-flex gap-2 flex-wrap">
								<button type="submit" class="btn btn-primary" style="min-height:44px;">
									<i class="ti ti-user-check me-2"></i>{{ 'acceptJoinRequest'|trans }}
								</button>
								<button type="submit" class="btn btn-outline-secondary" style="min-height:44px;" form="ignore-join-request-{{ joinRequest.id }}">{{ 'ignore'|trans }}</button>
							</div>
						</form>
						<form method="post" id="ignore-join-request-{{ joinRequest.id }}" action="{{ path('club_join_request_ignore', {id: joinRequest.id}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('ignore-join-request-' ~ joinRequest.id) }}">
						</form>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}
	<div class="row">
		{% for invitation in invitations %}
			<div class="col-12 col-lg-6 mb-3 d-flex">
				<a href="{{ path('club_invitation_show', {id: invitation.id}) }}"
				   class="tarmac-card w-100"
				   style="display:flex;flex-direction:column;">

					<div class="tarmac-card__head">
						<span class="tarmac-eqv" style="background:var(--td-glow-soft);color:var(--td-warning);">
							<i class="ti ti-mail"></i>
						</span>
						<div class="flex-fill" style="min-width:0;">
							<h3 class="tarmac-card__title" style="overflow:hidden;text-overflow:ellipsis;">
								{{ invitation.fullname ?: invitation.email }}
							</h3>
							{% if invitation.fullname %}
								<div class="tarmac-card__meta" style="overflow:hidden;text-overflow:ellipsis;">
									<i class="ti ti-at"></i>{{ invitation.email }}
								</div>
							{% endif %}
						</div>
					</div>

					<div class="tarmac-card__badges" style="margin-top:0.5rem;">
						{% if invitation.isManager %}
							<span class="tarmac-badge tarmac-badge--success"><i class="ti ti-shield"></i>{{ 'manager'|trans }}</span>
						{% endif %}
						{% if invitation.isInspector %}
							<span class="tarmac-badge tarmac-badge--glow"><i class="ti ti-eye-check"></i>{{ 'inspector'|trans }}</span>
						{% endif %}
						{% if invitation.isPilote %}
							<span class="tarmac-badge tarmac-badge--info"><i class="ti ti-plane"></i>{{ 'pilot'|trans }}</span>
						{% endif %}
						{% if not invitation.isManager and not invitation.isInspector and not invitation.isPilote %}
							<span class="tarmac-badge tarmac-badge--secondary"><i class="ti ti-user"></i>{{ 'member'|trans }}</span>
						{% endif %}
						{% if invitation.isLocked %}
							<span class="tarmac-badge tarmac-badge--azure"><i class="ti ti-lock"></i>{{ 'existingUser'|trans }}</span>
						{% endif %}
					</div>

					<div class="tarmac-card__footer d-flex align-items-center justify-content-between gap-2" style="margin-top:auto;">
						<span class="tarmac-card__meta">
							<i class="ti ti-calendar"></i>{{ 'sentOn'|trans }} {{ invitation.createdAt|date('d/m/Y') }}
						</span>
						<span class="tarmac-card__meta">
							<i class="ti ti-clock"></i>{{ 'expiresOn'|trans }} {{ invitation.expiresAt|date('d/m/Y') }}
						</span>
					</div>
				</a>
			</div>
		{% else %}
			<div class="col-12">
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-mail-opened"></i></div>
					<p class="text-secondary" style="margin:0 0 1rem;"><em>{{ 'noPendingInvitations'|trans }}</em></p>
					<a href="{{ path('club_invitation_create') }}" class="btn btn-primary">
						<i class="ti ti-plus me-2"></i>{{ 'inviteNewMember'|trans }}
					</a>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="d-flex justify-content-center mt-4">
		{{ pagination(invitations) }}
	</div>
{% endblock %}
