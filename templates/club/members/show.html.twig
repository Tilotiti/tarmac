{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ membership.user.fullname }}
{% endblock %}

{% block page_pretitle %}
	<span class="tarmac-page-eyebrow" style="cursor:default;">
		<span class="tarmac-eqv" style="background:var(--td-mid-soft);color:var(--td-mid);">
			<i class="ti ti-user"></i>
		</span>
		{{ 'member'|trans }}
	</span>
{% endblock %}

{% block page_actions %}
	{% if is_granted('MANAGE', club) or (currentMembership is defined and (currentMembership.isManager or currentMembership.isInspector)) %}
		<div class="btn-list">
			{% if currentMembership is defined and (currentMembership.isManager or currentMembership.isInspector) %}
				<a href="{{ path('club_member_logbook', {id: membership.id}) }}" class="btn btn-outline-secondary">
					<i class="ti ti-notebook me-2"></i>
					<span class="d-none d-sm-inline">{{ 'mechanicLogbook'|trans }}</span>
					<span class="d-inline d-sm-none">{{ 'logbook'|trans }}</span>
				</a>
			{% endif %}

			{% if is_granted('MANAGE', club) %}
				<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-edit-roles">
					<i class="ti ti-edit me-2"></i>
					<span class="d-none d-sm-inline">{{ 'editRoles'|trans }}</span>
					<span class="d-inline d-sm-none">{{ 'roles'|trans }}</span>
				</button>

				<div class="dropdown d-inline-block" data-controller="dropdown">
					<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
						<i class="ti ti-dots-vertical"></i>
					</button>
					<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
						<form method="post" action="{{ path('club_member_delete', {id: membership.id}) }}" onsubmit="return confirm('{{ 'confirmRemoveFromClub'|trans({'memberName': membership.user.fullname}) }}');">
							<button type="submit" class="dropdown-item text-danger">
								<i class="ti ti-trash me-2"></i>{{ 'removeFromClub'|trans }}
							</button>
						</form>
					</div>
				</div>
			{% endif %}
		</div>
	{% endif %}
{% endblock %}

{% block page_content %}
	{% if openModal %}<div data-auto-open-modal="modal-edit-roles"></div>{% endif %}

	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-user-circle"></i>
					{{ 'memberInformation'|trans }}
				</div>

				<div class="d-flex align-items-center gap-3 flex-wrap">
					<span class="contributor-avatar contributor-avatar--c{{ membership.user.id % 8 }}" style="width:64px;height:64px;font-size:1.4rem;flex-shrink:0;">
						{{ membership.user.firstname[:1]|upper }}{{ membership.user.lastname[:1]|upper }}
					</span>
					<div class="flex-fill" style="min-width:0;">
						<h3 style="font-size:1.3rem;font-weight:700;margin:0 0 0.3rem;{% if not membership.user.active %}color:var(--td-danger);{% endif %}">
							{{ membership.user.fullname }}
						</h3>
						<div class="text-secondary" style="font-size:0.92rem;">
							<i class="ti ti-mail me-1"></i>{{ membership.user.email }}
						</div>
						{% if not membership.user.active %}
							<div class="mt-2">
								<span class="tarmac-badge tarmac-badge--status-cancelled">
									<i class="ti ti-ban"></i>{{ 'accountDisabled'|trans }}
								</span>
							</div>
						{% endif %}
					</div>
				</div>

				<div class="tarmac-card__badges" style="margin-top:1rem;">
					{% if membership.isManager %}
						<span class="tarmac-badge tarmac-badge--success"><i class="ti ti-user-star"></i>{{ 'manager'|trans }}</span>
					{% endif %}
					{% if membership.isInspector %}
						<span class="tarmac-badge tarmac-badge--glow" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'qualifiedTooltip'|trans }}">
							<i class="ti ti-shield-check"></i>{{ 'inspector'|trans }}
						</span>
					{% endif %}
					{% if membership.isPilote %}
						<span class="tarmac-badge tarmac-badge--info" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'pilotTooltip'|trans }}">
							<i class="ti ti-plane"></i>{{ 'pilot'|trans }}
						</span>
					{% endif %}
					{% if not membership.isManager and not membership.isInspector and not membership.isPilote %}
						<span class="tarmac-badge tarmac-badge--secondary"><i class="ti ti-user"></i>{{ 'member'|trans }}</span>
					{% endif %}
				</div>
			</div>
		</div>

		{# ========== Sidebar ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'joinedOn'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ membership.joinedAt|date('d/m/Y') }}</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'createdOn'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ membership.createdAt|date('d/m/Y') }}</span>
						</li>
					</ul>
				</div>
			</div>
		</div>

	</div>

	{# Modal éditer les rôles - inchangé fonctionnellement #}
	{% if is_granted('MANAGE', club) %}
		<div class="modal modal-blur fade" id="modal-edit-roles" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered" role="document">
				<div class="modal-content">
					{{ form_start(form, {'attr': {'id': 'form-edit-roles'}}) }}
					<div class="modal-header">
						<h5 class="modal-title">{{ 'editRoles'|trans }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						{% for field in [form.isManager, form.isInspector, form.isPilote] %}
							<div class="mb-3">
								<div class="form-check">
									<input type="checkbox" id="{{ field.vars.id }}" name="{{ field.vars.full_name }}" class="form-check-input" value="1" {% if field.vars.checked %} checked {% endif %}>
									<label class="form-check-label" for="{{ field.vars.id }}">
										<div>{{ field.vars.label|trans }}</div>
										{% if field.vars.help %}
											<div class="text-secondary small">{{ field.vars.help|trans }}</div>
										{% endif %}
									</label>
								</div>
								{{ form_errors(field) }}
							</div>
						{% endfor %}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
							<i class="ti ti-x me-2"></i>{{ 'cancel'|trans }}
						</button>
						<button type="submit" class="btn btn-primary">
							<i class="ti ti-check me-2"></i>{{ 'save'|trans }}
						</button>
					</div>
					{% do form.isManager.setRendered %}
					{% do form.isInspector.setRendered %}
					{% do form.isPilote.setRendered %}
					{{ form_end(form) }}
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
