{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'dashboard'|trans }}
{% endblock %}

{% block page_actions %}
	{% if is_granted('MANAGE') %}
		<a href="{{ path('club_task_new') }}" class="btn btn-primary">
			<i class="ti ti-plus me-1"></i>
			{{ 'newTask'|trans }}
		</a>
	{% endif %}
{% endblock %}

{% block page_content %}
	{# KPI strip — pouls du club #}
	<div class="row g-2 mb-4">
		<div class="col-6 col-md-3">
			<a href="{{ path('club_tasks', {'status': 'open'}) }}" class="tarmac-kpi">
				<span class="tarmac-kpi__icon"><i class="ti ti-list-check"></i></span>
				<div class="tarmac-kpi__label">{{ 'openTasks'|trans }}</div>
				<div class="tarmac-kpi__value">{{ openTasksCount }}</div>
			</a>
		</div>
		<div class="col-6 col-md-3">
			<a href="{{ path('club_tasks') }}" class="tarmac-kpi tarmac-kpi--danger">
				<span class="tarmac-kpi__icon"><i class="ti ti-flag"></i></span>
				<div class="tarmac-kpi__label">{{ 'priorityTasks'|trans }}</div>
				<div class="tarmac-kpi__value">{{ priorityTasksCount }}</div>
			</a>
		</div>
		{% if isInspector %}
			<div class="col-6 col-md-3">
				<a href="{{ path('club_tasks', {'awaitingInspection': '1'}) }}" class="tarmac-kpi tarmac-kpi--glow">
					<span class="tarmac-kpi__icon"><i class="ti ti-shield-check"></i></span>
					<div class="tarmac-kpi__label">{{ 'subTasksToValidate'|trans }}</div>
					<div class="tarmac-kpi__value">{{ awaitingInspectionCount }}</div>
				</a>
			</div>
		{% endif %}
		<div class="col-6 col-md-3{% if not isInspector %} col-md-6{% endif %}">
			<a href="{{ path('club_purchases', {'status': 'purchased'}) }}" class="tarmac-kpi tarmac-kpi--purple">
				<span class="tarmac-kpi__icon"><i class="ti ti-truck"></i></span>
				<div class="tarmac-kpi__label">{{ 'purchasesWaitingDelivery'|trans }}</div>
				<div class="tarmac-kpi__value">{{ purchasesWaitingDeliveryCount }}</div>
			</a>
		</div>
	</div>

	{# Welcome Message — « mot du gestionnaire » #}
	{% if club.welcomeMessage %}
		<div class="tarmac-welcome mb-4">
			<span class="tarmac-welcome__kicker">
				<i class="ti ti-quote me-1"></i>{{ 'welcomeMessageKicker'|trans }}
			</span>
			<div class="tarmac-welcome__body text-body">
				{{ club.welcomeMessage|markdown_to_html }}
			</div>
			{% if is_granted('MANAGE') or club.welcomeMessageUpdatedAt %}
				<div class="tarmac-welcome__footer">
					<span class="tarmac-welcome__edited">
						{% if club.welcomeMessageUpdatedAt %}
							{% set updatedBy = club.welcomeMessageUpdatedBy %}
							{% if updatedBy %}
								{{ 'welcomeMessageUpdatedByOn'|trans({
									name: updatedBy.fullName|default(updatedBy.email),
									date: club.welcomeMessageUpdatedAt|date('d/m/Y')
								}) }}
							{% else %}
								{{ 'welcomeMessageUpdatedOn'|trans({
									date: club.welcomeMessageUpdatedAt|date('d/m/Y')
								}) }}
							{% endif %}
						{% endif %}
					</span>
					{% if is_granted('MANAGE') %}
						<a href="{{ path('club_dashboard_edit_welcome_message') }}" class="btn btn-sm btn-outline-secondary">
							<i class="ti ti-edit me-1"></i>
							{{ 'edit'|trans }}
						</a>
					{% endif %}
				</div>
			{% endif %}
		</div>
	{% elseif is_granted('MANAGE') %}
		<div class="tarmac-welcome mb-4">
			<span class="tarmac-welcome__kicker">
				<i class="ti ti-quote me-1"></i>{{ 'welcomeMessageKicker'|trans }}
			</span>
			<div class="tarmac-welcome__body text-body">
				<p>{{ 'noWelcomeMessage'|trans }}</p>
			</div>
			<div class="tarmac-welcome__footer">
				<span class="tarmac-welcome__edited"></span>
				<a href="{{ path('club_dashboard_edit_welcome_message') }}" class="btn btn-sm btn-primary">
					<i class="ti ti-plus me-1"></i>
					{{ 'addWelcomeMessage'|trans }}
				</a>
			</div>
		</div>
	{% endif %}

	{# SubTasks Awaiting Inspection (Inspector View) #}
	{% if is_granted('INSPECT') and awaitingInspectionSubTasks is not empty %}
		<div class="mb-4">
			<div class="tarmac-section-bar">
				<h3 class="tarmac-section-bar__title">
					<i class="ti ti-shield-check"></i>
					{{ 'subTasksToValidate'|trans }}
					<span class="tarmac-section-bar__count">{{ awaitingInspectionCount }}</span>
				</h3>
				<div class="tarmac-section-bar__actions">
					{% if awaitingInspectionCount > 5 %}
						<a href="{{ path('club_tasks', {'awaitingInspection': '1'}) }}" class="btn btn-sm btn-outline-secondary">
							<i class="ti ti-arrow-right me-1"></i><span class="btn-text">{{ 'seeAll'|trans }}</span>
						</a>
					{% endif %}
				</div>
			</div>
			<div class="row">
				{% for subTask in awaitingInspectionSubTasks %}
					{% include 'component/subTaskCard.html.twig' with {'subTask': subTask} %}
				{% endfor %}
			</div>
		</div>
	{% endif %}

	{# Priority Tasks #}
	{% if priorityTasks is not empty %}
		<div class="mb-4">
			<div class="tarmac-section-bar">
				<h3 class="tarmac-section-bar__title">
					<i class="ti ti-flag"></i>
					{{ 'priorityTasks'|trans }}
					<span class="tarmac-section-bar__count">{{ priorityTasksCount }}</span>
				</h3>
				<div class="tarmac-section-bar__actions">
					{% if is_granted('MANAGE') %}
						<a href="{{ path('club_dashboard_print_priority_subtasks') }}" class="btn btn-sm btn-outline-secondary" target="_blank" title="{{ 'printPrioritySubTasks'|trans }}">
							<i class="ti ti-printer me-1"></i><span class="btn-text">{{ 'printPrioritySubTasks'|trans }}</span>
						</a>
					{% endif %}
					{% if priorityTasksCount > 20 %}
						<a href="{{ path('club_tasks') }}" class="btn btn-sm btn-outline-secondary">
							<i class="ti ti-arrow-right me-1"></i><span class="btn-text">{{ 'seeAll'|trans }}</span>
						</a>
					{% endif %}
				</div>
			</div>
			<div class="row">
				{% for task in priorityTasks %}
					{% include 'component/taskCard.html.twig' with {'task': task} %}
				{% endfor %}
			</div>
		</div>
	{% endif %}

	{# Legacy code kept for reference - Pending Maintenance Plan Applications #}
	{% if false and pendingApplications is not empty %}
		<div class="mb-4">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<h3 class="mb-0">
					<i class="ti ti-file-check"></i>
					{{ 'pendingPlans'|trans }}
					<span class="badge bg-secondary-lt ms-2">{{ pendingApplicationsCount }}</span>
				</h3>
				{% if pendingApplicationsCount > 5 %}
					{# Link to tasks page filtered by open status #}
					<a href="{{ path('club_tasks', {'status': 'open'}) }}" class="btn btn-sm btn-outline-primary">
						{{ 'seeAll'|trans }}
						<i class="ti ti-arrow-right ms-1"></i>
					</a>
				{% endif %}
			</div>
			<div class="row row-cards">
				{% for item in pendingApplications %}
					{% set application = item.application %}
					{% set tasks = item.tasks %}
					{% set totalTasks = application.tasks|length %}
					{% set closedTasks = 0 %}
					{% for task in application.tasks %}
						{% if task.status == 'closed' %}
							{% set closedTasks = closedTasks + 1 %}
						{% endif %}
					{% endfor %}
					{% set progress = totalTasks > 0 ? (closedTasks / totalTasks * 100)|round : 0 %}

					<div class="col-12">
						<a href="{{ path('club_equipment_show', {id: application.equipment.id}) }}" class="text-decoration-none">
							<div class="card card-link" style="cursor: pointer;">
								<div
									class="card-body">
									{# Header with equipment avatar and plan name #}
									<div
										class="d-flex align-items-start mb-3">
										{# Avatar with icon based on type #}
										<span class="avatar avatar-lg me-3 bg-{{ application.equipment.type.color }}-lt">
											<i class="ti {{ application.equipment.type.icon }} text-{{ application.equipment.type.color }}" style="font-size: 1.5rem;"></i>
										</span>
										<div
											class="flex-fill">
											{# Title: Equipment name #}
											<h4 class="card-title mb-1">{{ application.equipment.name }}</h4>
											{# Subtitle: Plan name #}
											<div class="text-secondary">{{ application.plan.name }}</div>
										</div>
										{# Badges on the right #}
										<div class="d-flex align-items-start flex-wrap gap-2 ms-2">
											{% if application.dueAt %}
												<span class="badge bg-azure-lt">
													<i class="ti ti-calendar me-1"></i>
													{{ application.dueAt|date('d/m/Y') }}
												</span>
											{% endif %}
											{# Owner badge #}
											{% if application.equipment.isPrivate %}
												<span class="badge bg-orange-lt">
													<i class="ti ti-user me-1"></i>
													{{ 'private'|trans }}
												</span>
											{% else %}
												<span class="badge bg-blue-lt">
													<i class="ti ti-building me-1"></i>
													{{ 'club'|trans }}
												</span>
											{% endif %}
											<span class="badge bg-{{ application.equipment.type.color }}-lt">
												<i class="ti {{ application.equipment.type.icon }} me-1"></i>
												{{ application.equipment.type.label|trans }}
											</span>
										</div>
									</div>

									{# Progress bar #}
									<div>
										<div class="d-flex align-items-center justify-content-between mb-2">
											<span class="text-secondary">{{ 'progress'|trans }}</span>
											<span>
												<strong>{{ closedTasks }}</strong>
												<span class="text-secondary">/</span>
												<span class="text-secondary">{{ totalTasks }}</span>
												<span class="text-secondary ms-2">({{ progress|number_format(0) }}%)</span>
											</span>
										</div>
										<div class="progress" style="height: 0.5rem;">
											<div class="progress-bar bg-primary" style="width: {{ progress }}%" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100"></div>
										</div>
									</div>
								</div>
							</div>
						</a>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}

	{# Legacy code kept for reference - Standalone Pending Tasks #}
	{% if false and standaloneTasks is not empty %}
		<div class="mb-4">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<h3 class="mb-0">
					<i class="ti ti-checklist"></i>
					{{ 'pendingTasks'|trans }}
					<span class="badge bg-secondary-lt ms-2">{{ standaloneTasksCount }}</span>
				</h3>
				{% if standaloneTasksCount > 5 %}
					<a href="{{ path('club_tasks', {'status': 'open'}) }}" class="btn btn-sm btn-outline-info">
						{{ 'seeAll'|trans }}
						<i class="ti ti-arrow-right ms-1"></i>
					</a>
				{% endif %}
			</div>
			<div class="row">
				{% for task in standaloneTasks %}
					{% include 'component/taskCard.html.twig' with {'task': task} %}
				{% endfor %}
			</div>
		</div>
	{% endif %}

	{# Purchases Waiting for Delivery #}
	{% if purchasesWaitingDelivery is not empty %}
		<div class="mb-4">
			<div class="tarmac-section-bar">
				<h3 class="tarmac-section-bar__title">
					<i class="ti ti-truck"></i>
					{{ 'purchasesWaitingDelivery'|trans }}
					<span class="tarmac-section-bar__count">{{ purchasesWaitingDeliveryCount }}</span>
				</h3>
				<div class="tarmac-section-bar__actions">
					{% if purchasesWaitingDeliveryCount > 5 %}
						<a href="{{ path('club_purchases', {'status': 'purchased'}) }}" class="btn btn-sm btn-outline-secondary">
							<i class="ti ti-arrow-right me-1"></i><span class="btn-text">{{ 'seeAll'|trans }}</span>
						</a>
					{% endif %}
				</div>
			</div>
			<div class="row">
				{% for purchase in purchasesWaitingDelivery %}
					<div class="col-12 col-md-6 col-lg-4 mb-3 d-flex">
						<a href="{{ path('club_purchase_show', {id: purchase.id}) }}" class="tarmac-card w-100">
							<div class="tarmac-card__eyebrow">
								<i class="ti ti-shopping-cart"></i>
								{{ 'purchaseQuantity'|trans }} : {{ purchase.quantity }}
							</div>
							<h4 class="tarmac-card__title">{{ purchase.name }}</h4>
							{% if purchase.purchasedBy %}
								<div class="tarmac-card__meta">
									<i class="ti ti-user"></i>
									{{ purchase.purchasedBy.fullName ?? purchase.purchasedBy.email }} ·
									{{ purchase.purchasedAt|date('d/m/Y') }}
								</div>
							{% endif %}
						</a>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}

	{# Empty state #}
	{% if priorityTasks is empty and purchasesWaitingDelivery is empty and (not is_granted('INSPECT') or awaitingInspectionSubTasks is empty) %}
		<div class="empty">
			<div class="empty-icon">
				<i class="ti ti-clipboard-check"></i>
			</div>
			<p class="empty-title">{{ 'noPendingTasks'|trans }}</p>
			<p class="empty-subtitle text-secondary">
				{{ 'noPendingTasksDescription'|trans }}
			</p>
			<div class="empty-action">
				<a href="{{ path('club_task_new') }}" class="btn btn-primary">
					<i class="ti ti-plus"></i>
					{{ 'newTask'|trans }}
				</a>
			</div>
		</div>
	{% endif %}
{% endblock %}
