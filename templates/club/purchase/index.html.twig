{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'purchases'|trans }}
{% endblock %}

{% block page_actions %}
	<a href="{{ path('club_purchase_new') }}" class="btn btn-primary">
		<i class="ti ti-plus me-2"></i>
		<span class="d-none d-sm-inline">{{ 'createPurchase'|trans }}</span>
		<span class="d-inline d-sm-none">{{ 'add'|trans }}</span>
	</a>
{% endblock %}

{% block page_content %}

	{# KPI strip — pouls du workflow d'achats #}
	{% set hasAnyKpi = kpi.pendingApproval + kpi.approved + kpi.purchased + kpi.delivered > 0 %}
	{% if hasAnyKpi %}
		<div class="row g-2 mb-4">
			{% if isManager %}
				<div class="col-6 col-md-3">
					<a href="{{ path('club_purchases', {'status': ['pending_approval']}) }}" class="tarmac-kpi tarmac-kpi--glow">
						<span class="tarmac-kpi__icon"><i class="ti ti-hourglass"></i></span>
						<div class="tarmac-kpi__label">{{ 'kpiToApprove'|trans }}</div>
						<div class="tarmac-kpi__value">{{ kpi.pendingApproval }}</div>
					</a>
				</div>
			{% endif %}
			<div class="col-6 col-md-3">
				<a href="{{ path('club_purchases', {'status': ['approved']}) }}" class="tarmac-kpi">
					<span class="tarmac-kpi__icon"><i class="ti ti-shopping-cart"></i></span>
					<div class="tarmac-kpi__label">{{ 'kpiToPurchase'|trans }}</div>
					<div class="tarmac-kpi__value">{{ kpi.approved }}</div>
				</a>
			</div>
			<div class="col-6 col-md-3">
				<a href="{{ path('club_purchases', {'status': ['purchased']}) }}" class="tarmac-kpi tarmac-kpi--purple">
					<span class="tarmac-kpi__icon"><i class="ti ti-truck"></i></span>
					<div class="tarmac-kpi__label">{{ 'kpiAwaitingDelivery'|trans }}</div>
					<div class="tarmac-kpi__value">{{ kpi.purchased }}</div>
				</a>
			</div>
			<div class="col-6 col-md-3">
				<a href="{{ path('club_purchases', {'status': ['delivered']}) }}" class="tarmac-kpi tarmac-kpi--success">
					<span class="tarmac-kpi__icon"><i class="ti ti-package"></i></span>
					<div class="tarmac-kpi__label">{{ 'kpiToValidate'|trans }}</div>
					<div class="tarmac-kpi__value">{{ kpi.delivered }}</div>
				</a>
			</div>
		</div>
	{% endif %}

	{% include 'component/filters.html.twig' with { form: filters } %}

	{# Purchase cards #}
	<div class="row">
		{% for purchase in purchases %}
			{% set isCancelled = purchase.status.value == 'cancelled' %}
			<div class="col-12 col-lg-6 mb-3 d-flex">
				<a href="{{ path('club_purchase_show', {id: purchase.id}) }}"
				   class="tarmac-card w-100{% if isCancelled %} tarmac-card--dimmed{% endif %}">

					{# Eyebrow : qui a demandé + quand #}
					<div class="tarmac-card__eyebrow">
						<i class="ti ti-user"></i>
						{{ 'requestedBy'|trans }} {{ purchase.createdBy.fullName|default(purchase.createdBy.email|default('—')) }} · {{ purchase.createdAt|date('d/m/Y') }}
					</div>

					{# Titre + icônes contextuelles #}
					<h3 class="tarmac-card__title d-flex align-items-center gap-2 flex-wrap">
						{{ purchase.name }}
						{% if purchase.description %}
							<i class="ti ti-info-circle text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ purchase.description }}" style="font-size:0.9rem;"></i>
						{% endif %}
						{% if purchase.requestImage %}
							<i class="ti ti-photo text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'hasImages'|trans }}" style="font-size:0.9rem;"></i>
						{% endif %}
						{% if purchase.billImage %}
							<i class="ti ti-file-invoice text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'hasInvoice'|trans }}" style="font-size:0.9rem;"></i>
						{% endif %}
					</h3>

					{# Badges : statut + quantité #}
					<div class="tarmac-card__badges" style="margin-top:0.4rem;">
						{% set s = purchase.status.value %}
						{% if isCancelled %}
							<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ s|trans }}</span>
						{% elseif s == 'pending_approval' %}
							<span class="tarmac-badge tarmac-badge--status-inspection"><i class="ti ti-hourglass"></i>{{ s|trans }}</span>
						{% elseif s == 'approved' %}
							<span class="tarmac-badge tarmac-badge--info"><i class="ti ti-check"></i>{{ s|trans }}</span>
						{% elseif s == 'purchased' %}
							<span class="tarmac-badge tarmac-badge--azure"><i class="ti ti-shopping-cart"></i>{{ s|trans }}</span>
						{% elseif s == 'delivered' %}
							<span class="tarmac-badge tarmac-badge--azure"><i class="ti ti-truck"></i>{{ s|trans }}</span>
						{% elseif s == 'complete' %}
							<span class="tarmac-badge tarmac-badge--status-closed"><i class="ti ti-package"></i>{{ s|trans }}</span>
						{% elseif s == 'reimbursed' %}
							<span class="tarmac-badge tarmac-badge--status-closed"><i class="ti ti-cash"></i>{{ s|trans }}</span>
						{% else %}
							<span class="tarmac-badge tarmac-badge--info">{{ s|trans }}</span>
						{% endif %}
						<span class="tarmac-badge tarmac-badge--secondary">
							<i class="ti ti-package"></i>{{ 'purchaseQuantity'|trans }} : {{ purchase.quantity }}
						</span>
					</div>

					{# Stepper compact (remplace la progress %) — caché si annulé #}
					{% if not isCancelled %}
						<div class="tarmac-card__footer">
							{% include 'component/purchaseStepper.html.twig' with {purchase: purchase, compact: true} %}
						</div>
					{% endif %}
				</a>
			</div>
		{% else %}
			<div class="col-12">
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-shopping-cart"></i></div>
					<p class="text-secondary" style="margin:0 0 1rem;"><em>{{ 'noPurchasesFound'|trans }}</em></p>
					<a href="{{ path('club_purchase_new') }}" class="btn btn-primary">
						<i class="ti ti-plus me-2"></i>
						{{ 'createPurchase'|trans }}
					</a>
				</div>
			</div>
		{% endfor %}
	</div>

	{# Pagination #}
	<div class="d-flex justify-content-center mt-4">
		{{ pagination(purchases) }}
	</div>
{% endblock %}
