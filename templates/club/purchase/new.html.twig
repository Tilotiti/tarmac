{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'createPurchase'|trans }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_purchases') }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv" style="background:var(--td-mid-soft);color:var(--td-mid);">
			<i class="ti ti-shopping-cart"></i>
		</span>
		{{ 'purchases'|trans }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-8 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-plus"></i>{{ 'createPurchase'|trans }}
				</div>
				{{ form_start(form) }}
				{{ form_row(form.name) }}
				{{ form_row(form.quantity) }}
				{{ form_row(form.description) }}
				{{ form_row(form.requestImage) }}
				{{ form_row(form.billImage) }}
				{% do form.createAnother.setRendered %}

				<hr style="border-color: var(--td-border); margin: 1.25rem 0;">

				<div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
					<div class="form-check">
						<input type="checkbox" id="{{ form.createAnother.vars.id }}" name="{{ form.createAnother.vars.full_name }}" class="form-check-input" value="1" {% if form.createAnother.vars.checked %} checked {% endif %}>
						<label class="form-check-label" for="{{ form.createAnother.vars.id }}">
							{{ form.createAnother.vars.label|trans }}
						</label>
					</div>
					<div class="d-flex gap-2">
						<a href="{{ path('club_purchases') }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
						<button type="submit" class="btn btn-primary">
							<i class="ti ti-check me-2"></i>{{ 'create'|trans }}
						</button>
					</div>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
