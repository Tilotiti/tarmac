{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ purchase.name }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_purchases') }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv" style="background:var(--td-mid-soft);color:var(--td-mid);">
			<i class="ti ti-shopping-cart"></i>
		</span>
		{{ 'purchases'|trans }}
	</a>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		{# Action principale = prochaine étape du workflow #}
		{% if nextPrimaryAction == 'approve' and is_granted('PURCHASE_APPROVE', purchase) %}
			<a href="{{ path('club_purchase_approve', {id: purchase.id, _token: csrf_token('approve_purchase' ~ purchase.id)}) }}" class="btn btn-success" data-confirm="{{ 'confirmApprovePurchase'|trans }}">
				<i class="ti ti-check me-2"></i>
				<span class="d-none d-sm-inline">{{ 'approvePurchase'|trans }}</span>
			</a>
		{% elseif nextPrimaryAction == 'mark_purchased' and is_granted('PURCHASE_MARK_PURCHASED', purchase) %}
			<a href="{{ path('club_purchase_mark_purchased', {id: purchase.id}) }}" class="btn btn-primary" data-confirm="{{ 'confirmMarkAsPurchased'|trans }}">
				<i class="ti ti-shopping-cart me-2"></i>
				<span class="d-none d-sm-inline">{{ 'markAsPurchased'|trans }}</span>
			</a>
		{% elseif nextPrimaryAction == 'mark_delivered' and is_granted('PURCHASE_MARK_DELIVERED', purchase) %}
			<a href="{{ path('club_purchase_mark_delivered', {id: purchase.id, _token: csrf_token('mark_delivered_purchase' ~ purchase.id)}) }}" class="btn btn-success" data-confirm="{{ 'confirmMarkAsDelivered'|trans }}">
				<i class="ti ti-truck me-2"></i>
				<span class="d-none d-sm-inline">{{ 'markAsDelivered'|trans }}</span>
			</a>
		{% elseif nextPrimaryAction == 'mark_reimbursed' and is_granted('PURCHASE_MARK_REIMBURSED', purchase) %}
			<a href="{{ path('club_purchase_mark_reimbursed', {id: purchase.id, _token: csrf_token('mark_reimbursed_purchase' ~ purchase.id)}) }}" class="btn btn-success" data-confirm="{{ 'confirmMarkAsReimbursed'|trans }}">
				<i class="ti ti-cash me-2"></i>
				<span class="d-none d-sm-inline">{{ 'markAsReimbursed'|trans }}</span>
			</a>
		{% endif %}

		{# Menu kebab : Modifier + Annuler — actions secondaires #}
		{% set canEdit = is_granted('PURCHASE_EDIT', purchase) and not purchase.isCompleted %}
		{% set canCancel = is_granted('PURCHASE_CANCEL', purchase) and not purchase.isCompleted %}
		{% if canEdit or canCancel %}
			<div class="dropdown d-inline-block" data-controller="dropdown">
				<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
					<i class="ti ti-dots-vertical"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
					{% if canEdit %}
						<a href="{{ path('club_purchase_edit', {id: purchase.id}) }}" class="dropdown-item">
							<i class="ti ti-edit me-2"></i>{{ 'edit'|trans }}
						</a>
					{% endif %}
					{% if canEdit and canCancel %}
						<div class="dropdown-divider"></div>
					{% endif %}
					{% if canCancel %}
						<a href="{{ path('club_purchase_cancel', {id: purchase.id, _token: csrf_token('cancel_purchase' ~ purchase.id)}) }}" class="dropdown-item text-danger" data-confirm="{{ 'confirmCancelPurchase'|trans }}">
							<i class="ti ti-ban me-2"></i>{{ 'cancelPurchase'|trans }}
						</a>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block page_content %}
	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">

			{# Stepper du workflow — large, en haut #}
			<div class="tarmac-panel mb-3">
				<div class="tarmac-panel__title">
					<i class="ti ti-route"></i>
					{{ 'purchaseWorkflow'|trans }}
				</div>
				{% include 'component/purchaseStepper.html.twig' with {purchase: purchase, compact: false} %}
			</div>

			{# Description #}
			{% if purchase.description %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-align-left"></i>
						{{ 'purchaseDescription'|trans }}
					</div>
					<div style="font-size:0.95rem;line-height:1.6;color:var(--td-ink);">
						{{ purchase.description|nl2br }}
					</div>
				</div>
			{% endif %}

			{# Fichiers (request image + facture) #}
			{% if purchase.requestImage or purchase.billImage %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-paperclip"></i>
						{{ 'attachments'|trans|default('Pièces jointes') }}
					</div>
					<div class="row g-3">
						{% if purchase.requestImage %}
							<div class="col-12 col-md-6">
								<div class="text-secondary small mb-2">{{ 'purchaseRequestImageOrPdf'|trans }}</div>
								{% if purchase.requestImage matches '/\\.(jpg|jpeg|png|gif|webp)$/i' %}
									<div class="uploaded-file-thumbnail-compact">
										<a href="{{ purchase.requestImage }}" target="_blank" rel="noopener noreferrer">
											<img src="{{ purchase.requestImage }}" alt="{{ 'purchaseRequestImage'|trans }}">
										</a>
									</div>
								{% else %}
									<div class="uploaded-file-document-compact">
										<div class="uploaded-file-document-compact-icon"><i class="ti ti-file-type-pdf"></i></div>
										<div class="uploaded-file-document-compact-label">{{ 'pdfDocument'|trans }}</div>
										<a href="{{ purchase.requestImage }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
											<i class="ti ti-external-link me-2"></i>{{ 'viewFile'|trans }}
										</a>
									</div>
								{% endif %}
							</div>
						{% endif %}

						{% if purchase.billImage %}
							<div class="col-12 col-md-6">
								<div class="text-secondary small mb-2">{{ 'purchaseBillImageOrPdf'|trans }}</div>
								{% if purchase.billImage matches '/\\.(jpg|jpeg|png|gif|webp)$/i' %}
									<div class="uploaded-file-thumbnail-compact">
										<a href="{{ purchase.billImage }}" target="_blank" rel="noopener noreferrer">
											<img src="{{ purchase.billImage }}" alt="{{ 'purchaseBillImage'|trans }}">
										</a>
									</div>
								{% else %}
									<div class="uploaded-file-document-compact">
										<div class="uploaded-file-document-compact-icon"><i class="ti ti-file-type-pdf"></i></div>
										<div class="uploaded-file-document-compact-label">{{ 'pdfDocument'|trans }}</div>
										<a href="{{ purchase.billImage }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
											<i class="ti ti-external-link me-2"></i>{{ 'viewBill'|trans }}
										</a>
									</div>
								{% endif %}
							</div>
						{% endif %}
					</div>
				</div>
			{% endif %}

			{# Activity & comments — pattern unifié #}
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-history"></i>
					{{ 'activity'|trans }}
				</div>

				{% if purchase.mainActivities|length > 0 %}
					<ul class="tarmac-timeline">
						{% for activity in purchase.mainActivities %}
							{% set iconVariant = activity.typeColor in ['success', 'green'] ? 'success'
								: activity.typeColor in ['warning', 'orange', 'yellow'] ? 'warning'
								: activity.typeColor in ['danger', 'red'] ? 'danger'
								: activity.typeColor in ['azure', 'cyan', 'info'] ? 'azure'
								: activity.typeColor == 'purple' ? 'purple'
								: '' %}
							<li class="tarmac-timeline__item">
								<span class="tarmac-timeline__icon{% if iconVariant %} tarmac-timeline__icon--{{ iconVariant }}{% endif %}">
									<i class="ti {{ activity.typeIcon }}"></i>
								</span>
								<div class="tarmac-timeline__head">
									<span class="tarmac-timeline__author">{{ activity.user.fullName ?? activity.user.email }}</span>
									<span class="tarmac-timeline__action">{{ activity.typeLabel|trans|lower }}</span>
									<span class="tarmac-timeline__date">{{ activity.createdAt|date('d/m/Y H:i') }}</span>
								</div>
								{% if activity.message %}
									<div class="tarmac-timeline__body">{{ activity.message|nl2br }}</div>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				{% else %}
					<p class="text-secondary" style="margin:0;font-size:0.9rem;">
						<em>{{ 'noActivityYet'|trans }}</em>
					</p>
				{% endif %}

				{# Comment form #}
				{% if commentForm is defined %}
					<hr style="border-color: var(--td-border); margin: 1.25rem 0;">
					{{ form_start(commentForm, {action: path('club_purchase_comment', {id: purchase.id})}) }}
						<label for="{{ commentForm.message.vars.id }}" class="form-label">
							<i class="ti ti-message me-1"></i>{{ 'addComment'|trans }}
						</label>
						<div class="mb-3">
							{{ form_widget(commentForm.message) }}
						</div>
						<button type="submit" class="btn btn-primary btn-sm">
							<i class="ti ti-send me-1"></i>
							{{ 'addComment'|trans }}
						</button>
					{{ form_end(commentForm) }}
				{% endif %}
			</div>

		</div>{# /col-12 col-lg-8 (main) #}

		{# ========== Sidebar ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">

				{# Panel : détails #}
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>
						{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'status'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% set s = purchase.status.value %}
								{% if s == 'cancelled' %}
									<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ s|trans }}</span>
								{% elseif s == 'pending_approval' %}
									<span class="tarmac-badge tarmac-badge--status-inspection"><i class="ti ti-hourglass"></i>{{ s|trans }}</span>
								{% elseif s == 'complete' or s == 'reimbursed' %}
									<span class="tarmac-badge tarmac-badge--status-closed"><i class="ti ti-circle-check"></i>{{ s|trans }}</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--info">{{ s|trans }}</span>
								{% endif %}
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'purchaseQuantity'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ purchase.quantity }}</span>
						</li>
						{% if purchase.expectedDeliveryDate %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'purchaseExpectedDeliveryDate'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-calendar me-1 text-secondary"></i>{{ purchase.expectedDeliveryDate|date('d/m/Y') }}
								</span>
							</li>
						{% endif %}
					</ul>
				</div>

				{# Panel : parcours (qui a fait quoi quand) #}
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-users"></i>
						{{ 'purchaseJourney'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						{% if purchase.createdBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'requestedBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.createdBy.fullName|default(purchase.createdBy.email) }}
									{% if purchase.createdAt %}<div class="tarmac-meta-list__sub">{{ purchase.createdAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
						{% if purchase.approvedBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'approvedBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.approvedBy.fullName|default(purchase.approvedBy.email) }}
									{% if purchase.approvedAt %}<div class="tarmac-meta-list__sub">{{ purchase.approvedAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
						{% if purchase.purchasedBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'purchasedBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.purchasedBy.fullName|default(purchase.purchasedBy.email) }}
									{% if purchase.purchasedAt %}<div class="tarmac-meta-list__sub">{{ purchase.purchasedAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
						{% if purchase.deliveredBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'deliveredBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.deliveredBy.fullName|default(purchase.deliveredBy.email) }}
									{% if purchase.deliveredAt %}<div class="tarmac-meta-list__sub">{{ purchase.deliveredAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
						{% if purchase.reimbursedBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'reimbursedBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.reimbursedBy.fullName|default(purchase.reimbursedBy.email) }}
									{% if purchase.reimbursedAt %}<div class="tarmac-meta-list__sub">{{ purchase.reimbursedAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
						{% if purchase.cancelledBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'cancelledBy'|trans }}</span>
								<span class="tarmac-meta-list__value">
									{{ purchase.cancelledBy.fullName|default(purchase.cancelledBy.email) }}
									{% if purchase.cancelledAt %}<div class="tarmac-meta-list__sub">{{ purchase.cancelledAt|date('d/m/Y H:i') }}</div>{% endif %}
								</span>
							</li>
						{% endif %}
					</ul>
				</div>

			</div>
		</div>

	</div>{# /row g-3 #}
{% endblock %}
