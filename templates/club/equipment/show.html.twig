{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ equipment.name }}
{% endblock %}

{% block page_pretitle %}
	<span class="tarmac-page-eyebrow" style="cursor:default;">
		<span class="tarmac-eqv tarmac-eqv--{{ equipment.type.color }}">
			<i class="ti {{ equipment.type.icon }}"></i>
		</span>
		{{ equipment.type.label|trans }}
	</span>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		<a href="{{ path('club_tasks', {'filters[equipment]': equipment.id, 'filters[status]': 'open'}) }}" class="btn btn-outline-secondary">
			<i class="ti ti-checklist me-2"></i>
			<span class="d-none d-sm-inline">{{ 'viewTasks'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'tasks'|trans }}</span>
		</a>

		{% if is_granted('MANAGE', club) %}
			<a href="{{ path('club_equipment_apply_plan', {id: equipment.id}) }}" class="btn btn-primary">
				<i class="ti ti-clipboard-plus me-2"></i>
				<span class="d-none d-sm-inline">{{ 'applyNewPlan'|trans }}</span>
				<span class="d-inline d-sm-none">{{ 'applyPlan'|trans }}</span>
			</a>

			<div class="dropdown d-inline-block" data-controller="dropdown">
				<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
					<i class="ti ti-dots-vertical"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
					<a href="{{ path('club_equipment_edit', {id: equipment.id}) }}" class="dropdown-item">
						<i class="ti ti-edit me-2"></i>{{ 'edit'|trans }}
					</a>
					<div class="dropdown-divider"></div>
					{% if equipment.active %}
						<form method="post" action="{{ path('club_equipment_disable', {id: equipment.id}) }}" onsubmit="return confirm('{{ 'confirmDisableEquipment'|trans }}');">
							<button type="submit" class="dropdown-item text-danger">
								<i class="ti ti-x me-2"></i>{{ 'disable'|trans }}
							</button>
						</form>
					{% else %}
						<form method="post" action="{{ path('club_equipment_enable', {id: equipment.id}) }}">
							<button type="submit" class="dropdown-item text-success">
								<i class="ti ti-check me-2"></i>{{ 'reactivate'|trans }}
							</button>
						</form>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block page_content %}
	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">

			{# Description #}
			{% if equipment.description %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-notes"></i>
						{{ 'description'|trans }}
					</div>
					<p class="text-secondary" style="margin:0;white-space:pre-line;">{{ equipment.description }}</p>
				</div>
			{% endif %}

			{# Plan Applications #}
			{% if applications|length > 0 %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-clipboard-check"></i>
						{{ 'maintenancePlans'|trans }}
						<span class="tarmac-section-bar__count" style="margin-left:auto;">{{ applications|length }}</span>
					</div>
					<div class="row">
						{% for application in applications %}
							{% set closedCount = application.closedTasks.count() %}
							{% set totalTasks = application.tasks.count() %}
							{% set progress = totalTasks > 0 ? (closedCount / totalTasks * 100)|round : 0 %}
							<div class="col-12 col-md-6 mb-2 d-flex">
								<a href="{{ path('club_plan_application_show', {id: application.id}) }}"
								   class="tarmac-card w-100{% if application.isCancelled %} tarmac-card--dimmed{% endif %}"
								   style="display:flex;flex-direction:column;">
									<h4 class="tarmac-card__title" style="font-size:0.95rem;">{{ application.plan.name }}</h4>
									<div class="tarmac-card__meta">
										<i class="ti ti-calendar"></i>{{ application.appliedAt|date('d/m/Y') }}
									</div>
									{% if application.dueAt %}
										<div class="tarmac-card__meta">
											<i class="ti ti-calendar-due"></i>{{ 'dueDate'|trans }} : {{ application.dueAt|date('d/m/Y') }}
										</div>
									{% endif %}
									<div class="tarmac-card__badges" style="margin-top:0.4rem;">
										{% if application.isCancelled %}
											<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ 'cancelled'|trans }}</span>
										{% else %}
											<span class="tarmac-badge tarmac-badge--info">{{ totalTasks }} {{ 'tasks'|trans|lower }}</span>
										{% endif %}
									</div>
									{% if totalTasks > 0 %}
										<div style="margin-top:0.6rem;">
											<div class="tarmac-progress-meta">
												<span><strong>{{ closedCount }}</strong> / {{ totalTasks }}</span>
												<span>{{ progress }} %</span>
											</div>
											<div class="tarmac-progress{% if progress == 100 %} tarmac-progress--done{% endif %}">
												<span style="width: {{ progress }}%"></span>
											</div>
										</div>
									{% endif %}
								</a>
							</div>
						{% endfor %}
					</div>
				</div>
			{% elseif is_granted('MANAGE', club) %}
				<div class="tarmac-panel mb-3" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-clipboard-check"></i></div>
					<h3 style="font-size:1.1rem;font-weight:700;margin-bottom:0.4rem;">{{ 'noMaintenancePlans'|trans }}</h3>
					<p class="text-secondary" style="margin:0 0 1rem;max-width:480px;margin-left:auto;margin-right:auto;">{{ 'noMaintenancePlansDescription'|trans }}</p>
					<a href="{{ path('club_equipment_apply_plan', {id: equipment.id}) }}" class="btn btn-primary">
						<i class="ti ti-clipboard-plus me-2"></i>{{ 'applyNewPlan'|trans }}
					</a>
				</div>
			{% endif %}

			{# Pending Tasks #}
			{% if pendingTasks|length > 0 %}
				<div class="mb-4">
					<div class="tarmac-section-bar">
						<h3 class="tarmac-section-bar__title">
							<i class="ti ti-checklist"></i>
							{{ 'pendingTasks'|trans }}
							<span class="tarmac-section-bar__count">{{ pendingTasks|length }}</span>
						</h3>
						<div class="tarmac-section-bar__actions">
							<a href="{{ path('club_tasks', {'filters[equipment]': equipment.id, 'filters[status]': 'open'}) }}" class="btn btn-sm btn-outline-secondary">
								<i class="ti ti-arrow-right me-1"></i><span class="btn-text">{{ 'viewAllTasks'|trans }}</span>
							</a>
						</div>
					</div>
					<div class="row">
						{% for task in pendingTasks %}
							{% include 'component/taskCard.html.twig' with {'task': task} %}
						{% endfor %}
					</div>
				</div>
			{% endif %}

		</div>{# /col-lg-8 (main) #}

		{# ========== Sidebar ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">

				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>
						{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'type'|trans }}</span>
							<span class="tarmac-meta-list__value">
								<span class="tarmac-badge tarmac-badge--{{ equipment.type.color == 'blue' ? 'info' : (equipment.type.color == 'green' ? 'success' : 'secondary') }}">
									<i class="ti {{ equipment.type.icon }}"></i>{{ equipment.type.label|trans }}
								</span>
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'status'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% if equipment.active %}
									<span class="tarmac-badge tarmac-badge--status-closed"><i class="ti ti-check"></i>{{ 'active'|trans }}</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ 'inactive'|trans }}</span>
								{% endif %}
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'owner'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% if equipment.isPrivate %}
									<span class="tarmac-badge tarmac-badge--warning"><i class="ti ti-user"></i>{{ 'private'|trans }}</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--info"><i class="ti ti-building"></i>{{ 'club'|trans }}</span>
								{% endif %}
							</span>
						</li>
						{% if equipment.responsible %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'responsible'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-user-shield me-1 text-secondary"></i>{{ equipment.responsible.fullname }}
								</span>
							</li>
						{% endif %}
						{% if equipment.createdBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'createdBy'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ equipment.createdBy.fullname }}</span>
							</li>
						{% endif %}
						<li>
							<span class="tarmac-meta-list__label">{{ 'createdAt'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ equipment.createdAt|date('d/m/Y H:i') }}</span>
						</li>
					</ul>
				</div>

				{% if equipment.isPrivate and equipment.owners|length > 0 %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-users"></i>
							{{ 'owners'|trans }}
							<span class="tarmac-section-bar__count" style="margin-left:auto;">{{ equipment.owners|length }}</span>
						</div>
						<ul class="tarmac-contributors">
							{% for owner in equipment.owners %}
								<li class="tarmac-contributors__item">
									<span class="contributor-avatar contributor-avatar--c{{ owner.id % 8 }}">
										{{ owner.firstname|default('')|slice(0, 1)|upper }}{{ owner.lastname|default('')|slice(0, 1)|upper }}
									</span>
									<span class="tarmac-contributors__name">{{ owner.fullname ?: owner.email }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

			</div>
		</div>

	</div>
{% endblock %}
