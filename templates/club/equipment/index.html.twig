{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'equipments'|trans }}
{% endblock %}

{% block page_actions %}
	{% if is_granted('MANAGE', club) %}
		<a href="{{ path('club_equipment_new') }}" class="btn btn-primary">
			<i class="ti ti-plus me-2"></i>
			<span class="d-none d-sm-inline">{{ 'addEquipment'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'add'|trans }}</span>
		</a>
	{% endif %}
{% endblock %}

{% block page_content %}
	{% include 'component/filters.html.twig' with { form: filters } %}

	<div class="row">
		{% for equipment in equipments %}
			{% set counts = pendingCounts[equipment.id] %}
			<div class="col-12 col-md-6 col-lg-4 mb-3 d-flex">
				<a href="{{ path('club_equipment_show', {id: equipment.id}) }}"
				   class="tarmac-card w-100{% if not equipment.active %} tarmac-card--dimmed{% endif %}"
				   style="display:flex;flex-direction:column;">

					<div class="tarmac-card__head">
						<span class="tarmac-eqv tarmac-eqv--{{ equipment.type.color }}">
							<i class="ti {{ equipment.type.icon }}"></i>
						</span>
						<div class="flex-fill" style="min-width:0;">
							<div class="tarmac-card__eyebrow">{{ equipment.type.label|trans }}</div>
							<h3 class="tarmac-card__title" style="overflow:hidden;text-overflow:ellipsis;">
								{{ equipment.name }}
							</h3>
						</div>
					</div>

					<div class="tarmac-card__badges" style="margin-top:0.5rem;">
						{% if equipment.isPrivate %}
							<span class="tarmac-badge tarmac-badge--warning"><i class="ti ti-user"></i>{{ 'private'|trans }}</span>
						{% else %}
							<span class="tarmac-badge tarmac-badge--info"><i class="ti ti-building"></i>{{ 'club'|trans }}</span>
						{% endif %}
						{% if not equipment.active %}
							<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-ban"></i>{{ 'disabled'|trans }}</span>
						{% endif %}
					</div>

					{% if counts.tasks > 0 or counts.subtasks > 0 %}
						<div class="tarmac-card__footer d-flex align-items-center gap-3" style="margin-top:auto;">
							{% if counts.tasks > 0 %}
								<span class="tarmac-card__meta" title="{{ 'pendingTasks'|trans }}">
									<i class="ti ti-checklist"></i>
									<strong style="color:var(--td-deep);">{{ counts.tasks }}</strong>
									<span style="margin-left:0.2rem;">{{ 'task'|trans|plural('fr') }}</span>
								</span>
							{% endif %}
							{% if counts.subtasks > 0 %}
								<span class="tarmac-card__meta" title="{{ 'pendingSubTasks'|trans }}">
									<i class="ti ti-checkbox"></i>
									<strong style="color:var(--td-deep);">{{ counts.subtasks }}</strong>
									<span style="margin-left:0.2rem;">{{ 'subTask'|trans|plural('fr') }}</span>
								</span>
							{% endif %}
						</div>
					{% endif %}
				</a>
			</div>
		{% else %}
			<div class="col-12">
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-package-off"></i></div>
					<p class="text-secondary" style="margin:0 0 1rem;"><em>{{ 'noEquipmentFound'|trans }}</em></p>
					{% if is_granted('MANAGE', club) %}
						<a href="{{ path('club_equipment_new') }}" class="btn btn-primary">
							<i class="ti ti-plus me-2"></i>
							{{ 'addEquipment'|trans }}
						</a>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="d-flex justify-content-center mt-4">
		{{ pagination(equipments) }}
	</div>
{% endblock %}
