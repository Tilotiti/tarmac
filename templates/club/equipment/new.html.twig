{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'addEquipment'|trans }}
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-8 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-plus"></i>{{ 'newEquipment'|trans }}
				</div>
				<div data-controller="equipment-privacy">
					{{ form_start(form) }}
					<div class="mb-3">
						{{ form_label(form.name) }}
						{{ form_widget(form.name) }}
						{{ form_errors(form.name) }}
					</div>

					<div class="mb-3">
						{{ form_label(form.type) }}
						{{ form_widget(form.type) }}
						{{ form_errors(form.type) }}
					</div>

					<div class="mb-3">
						{{ form_label(form.owner) }}
						<div data-action="change->equipment-privacy#toggleOwners">
							{{ form_widget(form.owner) }}
						</div>
						{{ form_errors(form.owner) }}
						<small class="form-text">{{ 'equipmentOwnershipHint'|trans }}</small>
					</div>

					<div class="mb-3 d-none" data-equipment-privacy-target="ownersContainer">
						{{ form_label(form.owners) }}
						{{ form_widget(form.owners) }}
						{{ form_errors(form.owners) }}
						<small class="form-text" data-equipment-privacy-target="counter">Aucun utilisateur sélectionné</small>
					</div>

					<div class="mb-3">
						{{ form_label(form.responsible) }}
						{{ form_widget(form.responsible) }}
						{{ form_errors(form.responsible) }}
						<small class="form-text">{{ 'equipmentResponsibleHint'|trans }}</small>
					</div>

					<div class="d-flex justify-content-end gap-2 mt-3">
						<a href="{{ path('club_equipments') }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
						<button type="submit" class="btn btn-primary">
							<i class="ti ti-check me-2"></i>{{ 'create'|trans|default('Créer') }}
						</button>
					</div>
					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
