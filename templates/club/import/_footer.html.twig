{# Pied de panneau des écrans d'import.
   Variables : submitLabel (clé), submitParams (paramètres ICU), submitIcon, submitDisabled (bool), backUrl, backLabel (clé), showAbandon (bool).
   Doit être rendu à l'intérieur du <form> principal ; le bouton d'abandon vise le formulaire caché « import-cancel-form ». #}
<div class="tarmac-panel__footer">
	<div class="tarmac-panel__footer-primary">
		<button type="submit" class="btn btn-primary w-100" {% if submitDisabled|default(false) %}disabled{% endif %}>
			<i class="ti {{ submitIcon|default('ti-arrow-right') }} me-2"></i>{{ submitLabel|trans(submitParams|default({})) }}
		</button>
	</div>
	<div class="tarmac-panel__footer-secondary">
		<a href="{{ backUrl }}" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-2"></i>{{ backLabel|trans }}</a>
		{% if showAbandon|default(false) %}
			<button type="submit" form="import-cancel-form" class="btn btn-ghost-danger"><i class="ti ti-x me-2"></i>{{ 'importAbandon'|trans }}</button>
		{% endif %}
	</div>
</div>
