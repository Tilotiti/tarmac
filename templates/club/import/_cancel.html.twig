{# Formulaire caché d'abandon : le bouton se trouve dans le pied de panneau (attribut form="import-cancel-form") #}
<form method="post" id="import-cancel-form" action="{{ path('club_import_cancel', {definition: definition.key}) }}" hidden>
	<input type="hidden" name="_token" value="{{ csrf_token('import-cancel') }}">
</form>
