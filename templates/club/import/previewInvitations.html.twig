{% extends 'club/import/preview.html.twig' %}

{% block preview_lead %}
	<p class="text-secondary">{{ 'importInvitationsPreviewHint'|trans }}</p>
{% endblock %}

{% block preview_extra_headers %}
	<th>{{ 'manager'|trans }}</th><th>{{ 'inspector'|trans }}</th><th>{{ 'pilot'|trans }}</th>
{% endblock %}

{% block preview_extra_cells %}
	{% if row.isImportable %}
		{# Marque la ligne comme soumise même si toutes les cases de rôle sont décochées :
		   sans elle, une case décochée disparaît du POST et import() retomberait sur les
		   rôles du fichier au lieu de respecter le décochage. #}
		<input type="hidden" name="rows[{{ row.line }}][_submitted]" value="1">
	{% endif %}
	{% for role in ['isManager', 'isInspector', 'isPilote'] %}
		<td>
			{% if row.isImportable %}
				<input type="checkbox" class="form-check-input" name="rows[{{ row.line }}][{{ role }}]" value="1" {% if row.values[role] == 'yes' %}checked{% endif %} aria-label="{{ role == 'isManager' ? 'manager'|trans : (role == 'isInspector' ? 'inspector'|trans : 'pilot'|trans) }}">
			{% endif %}
		</td>
	{% endfor %}
{% endblock %}
