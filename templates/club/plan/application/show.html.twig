{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ application.plan.name }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_equipment_show', {id: application.equipment.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ application.equipment.type.color }}">
			<i class="ti {{ application.equipment.type.icon }}"></i>
		</span>
		{{ application.equipment.name }}
	</a>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		<a href="{{ path('club_plan_application_print', {id: application.id}) }}" class="btn btn-outline-secondary" target="_blank">
			<i class="ti ti-printer me-2"></i>
			<span class="d-none d-sm-inline">{{ 'printWorkCard'|trans }}</span>
			<span class="d-inline d-sm-none">{{ 'pdf'|trans }}</span>
		</a>

		{% if is_granted('MANAGE', club) and not application.isCancelled %}
			<div class="dropdown d-inline-block" data-controller="dropdown">
				<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
					<i class="ti ti-dots-vertical"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
					<button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelApplicationModal">
						<i class="ti ti-x me-2"></i>{{ 'cancelApplication'|trans }}
					</button>
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block page_content %}
	<div class="row g-3">

		{# Main : tasks #}
		<div class="col-12 col-lg-8">
			{% if application.isCancelled %}
				<div class="alert alert-warning mb-3">
					<div class="d-flex align-items-start">
						<i class="ti ti-alert-triangle me-2" style="font-size:1.2rem;"></i>
						<div>
							<strong>{{ 'cancelled'|trans }}</strong>
							<div style="font-size:0.85rem;">
								{{ 'cancelledAt'|trans }} : {{ application.cancelledAt|date('d/m/Y H:i') }}
								{% if application.cancelledBy %} · {{ 'by'|trans }} : {{ application.cancelledBy.fullname }}{% endif %}
							</div>
						</div>
					</div>
				</div>
			{% endif %}

			<div class="tarmac-section-bar">
				<h3 class="tarmac-section-bar__title">
					<i class="ti ti-checklist"></i>{{ 'tasks'|trans }}
					<span class="tarmac-section-bar__count">{{ tasks|length }}</span>
				</h3>
			</div>

			{% if tasks|length > 0 %}
				<div class="row">
					{% for task in tasks %}
						{% include 'component/taskCard.html.twig' with {'task': task} %}
					{% endfor %}
				</div>
			{% else %}
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-checklist"></i></div>
					<h4 style="font-size:1rem;font-weight:700;margin-bottom:0.3rem;">{{ 'noTasks'|trans }}</h4>
					<p class="text-secondary" style="margin:0;">{{ 'noTasksForApplication'|trans }}</p>
				</div>
			{% endif %}
		</div>

		{# Sidebar #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'status'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% if application.isCancelled %}
									<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ 'cancelled'|trans }}</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--status-open"><i class="ti ti-clock"></i>{{ 'active'|trans }}</span>
								{% endif %}
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'equipment'|trans }}</span>
							<span class="tarmac-meta-list__value">
								<a href="{{ path('club_equipment_show', {id: application.equipment.id}) }}">{{ application.equipment.name }}</a>
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'plan'|trans }}</span>
							<span class="tarmac-meta-list__value">
								<a href="{{ path('club_plan_show', {id: application.plan.id}) }}">{{ application.plan.name }}</a>
							</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'appliedBy'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ application.appliedBy.fullname }}</span>
						</li>
						<li>
							<span class="tarmac-meta-list__label">{{ 'appliedAt'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ application.appliedAt|date('d/m/Y H:i') }}</span>
						</li>
						{% if application.dueAt %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'dueDate'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-calendar-due me-1 text-secondary"></i>{{ application.dueAt|date('d/m/Y') }}
								</span>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</div>

	</div>

	{# Cancel Modal #}
	{% if is_granted('MANAGE', club) and not application.isCancelled %}
		<div class="modal fade" id="cancelApplicationModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ 'cancelApplication'|trans }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form method="post" action="{{ path('club_plan_application_cancel', {id: application.id}) }}">
						<input type="hidden" name="activity_form[_token]" value="{{ csrf_token('activity_form') }}">
						<div class="modal-body">
							<p>{{ 'confirmCancelApplication'|trans }}</p>
							<div class="mb-3">
								<label class="form-label">{{ 'cancellationReason'|trans }}</label>
								<textarea name="activity_form[message]" class="form-control" rows="3" placeholder="{{ 'optionalReason'|trans }}"></textarea>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="min-height: 44px;">{{ 'cancel'|trans }}</button>
							<button type="submit" class="btn btn-danger" style="min-height: 44px;">{{ 'cancelApplication'|trans }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
