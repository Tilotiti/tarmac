{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'planApplications'|trans }}
{% endblock %}

{% block page_content %}
	{% include 'component/filters.html.twig' with { form: filterForm } %}

	<div class="row">
		{% for application in applications %}
			{% set isCancelled = application.isCancelled %}
			<div class="col-12 col-lg-6 mb-3 d-flex">
				<a href="{{ path('club_plan_application_show', {id: application.id}) }}"
				   class="tarmac-card w-100{% if isCancelled %} tarmac-card--dimmed{% endif %}"
				   style="display:flex;flex-direction:column;">

					<div class="tarmac-card__head">
						<span class="tarmac-eqv tarmac-eqv--{{ application.equipment.type.color }}">
							<i class="ti {{ application.equipment.type.icon }}"></i>
						</span>
						<div class="flex-fill" style="min-width:0;">
							<div class="tarmac-card__eyebrow">{{ application.equipment.name }}</div>
							<h3 class="tarmac-card__title" style="overflow:hidden;text-overflow:ellipsis;">
								{{ application.plan.name }}
							</h3>
							<div class="tarmac-card__meta">
								<i class="ti ti-calendar"></i>{{ 'appliedAt'|trans }} : {{ application.appliedAt|date('d/m/Y') }}
							</div>
						</div>
					</div>

					<div class="tarmac-card__badges" style="margin-top:0.5rem;">
						{% if isCancelled %}
							<span class="tarmac-badge tarmac-badge--status-cancelled"><i class="ti ti-x"></i>{{ 'cancelled'|trans }}</span>
						{% else %}
							<span class="tarmac-badge tarmac-badge--status-open"><i class="ti ti-clock"></i>{{ 'active'|trans }}</span>
						{% endif %}
						{% if application.dueAt %}
							<span class="tarmac-badge tarmac-badge--secondary">
								<i class="ti ti-calendar-due"></i>{{ 'dueDate'|trans }} : {{ application.dueAt|date('d/m/Y') }}
							</span>
						{% endif %}
					</div>

					<div class="tarmac-card__footer" style="margin-top:auto;">
						<span class="tarmac-card__meta">
							<i class="ti ti-user"></i>{{ 'appliedBy'|trans }} : {{ application.appliedBy.fullname }}
						</span>
					</div>
				</a>
			</div>
		{% else %}
			<div class="col-12">
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-clipboard-check"></i></div>
					<p class="text-secondary" style="margin:0;"><em>{{ 'noPlanApplicationsFound'|trans }}</em></p>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="d-flex justify-content-center mt-4">
		{{ pagination(applications) }}
	</div>
{% endblock %}
