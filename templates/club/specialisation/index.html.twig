{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'specialisations'|trans }}
{% endblock %}

{% block page_actions %}
	<a href="{{ path('club_specialisation_new') }}" class="btn btn-primary">
		<i class="ti ti-plus me-2"></i>
		{{ 'newSpecialisation'|trans }}
	</a>
{% endblock %}

{% block page_content %}
	{% include 'component/filters.html.twig' with { form: filters } %}

	{% if specialisations is not empty %}
		<div class="row">
			{% for spec in specialisations %}
				<div class="col-12 col-md-6 col-lg-4 mb-3 d-flex">
					<div class="tarmac-card w-100" style="display:flex;flex-direction:column;">
						<div class="tarmac-card__head">
							<span class="tarmac-eqv" style="background:var(--td-neutral-soft);color:var(--td-neutral);">
								<i class="ti ti-tag"></i>
							</span>
							<div class="flex-fill" style="min-width:0;">
								<h3 class="tarmac-card__title" style="overflow:hidden;text-overflow:ellipsis;">{{ spec.name }}</h3>
								{% if spec.description %}
									<div class="tarmac-card__meta" style="font-size:0.85rem;color:var(--td-ink-2);">{{ spec.description }}</div>
								{% endif %}
							</div>
						</div>

						<div class="tarmac-card__footer d-flex align-items-center justify-content-end gap-1" style="margin-top:auto;">
							<a href="{{ path('club_specialisation_edit', {id: spec.id}) }}" class="btn btn-outline-secondary btn-sm" title="{{ 'edit'|trans }}">
								<i class="ti ti-edit"></i>
							</a>
							{% if specialisations|length > 1 %}
								<a href="{{ path('club_specialisation_merge', {id: spec.id}) }}" class="btn btn-outline-secondary btn-sm" title="{{ 'merge'|trans }}">
									<i class="ti ti-git-merge"></i>
								</a>
							{% endif %}
							<form method="post" action="{{ path('club_specialisation_delete', {id: spec.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'confirmDeleteSpecialisation'|trans|e('js') }}');">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ spec.id) }}">
								<button type="submit" class="btn btn-outline-danger btn-sm" title="{{ 'delete'|trans }}">
									<i class="ti ti-trash"></i>
								</button>
							</form>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

		<div class="d-flex justify-content-center mt-4">
			{{ pagination(specialisations) }}
		</div>
	{% else %}
		<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
			<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-tag-off"></i></div>
			<p class="text-secondary" style="margin:0 0 1rem;">{{ 'noSpecialisationsYet'|trans }}</p>
			<a href="{{ path('club_specialisation_new') }}" class="btn btn-primary">
				<i class="ti ti-plus me-2"></i>
				{{ 'newSpecialisation'|trans }}
			</a>
		</div>
	{% endif %}
{% endblock %}
