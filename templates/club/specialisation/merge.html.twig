{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'mergeSpecialisation'|trans }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_specialisations') }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv" style="background:var(--td-neutral-soft);color:var(--td-neutral);">
			<i class="ti ti-tag"></i>
		</span>
		{{ 'specialisations'|trans }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-6 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-git-merge"></i>{{ 'mergeSpecialisation'|trans }}
				</div>
				<p class="tarmac-form-hint">{{ 'mergeSpecialisationHelp'|trans({'name': specialisation.name}) }}</p>
				{{ form_start(form) }}
				<div class="mb-3">
					{{ form_label(form.target) }}
					{{ form_widget(form.target) }}
					{{ form_errors(form.target) }}
				</div>
				<div class="d-flex justify-content-end gap-2 mt-3">
					<a href="{{ path('club_specialisations') }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-git-merge me-2"></i>{{ 'merge'|trans }}
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
