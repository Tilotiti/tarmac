{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'newSpecialisation'|trans }}
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-6 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-tag"></i>{{ 'newSpecialisation'|trans }}
				</div>
				{{ form_start(form) }}
				<div class="mb-3">
					{{ form_label(form.name) }}
					{{ form_widget(form.name) }}
					{{ form_errors(form.name) }}
				</div>
				<div class="mb-3">
					{{ form_label(form.description) }}
					{{ form_widget(form.description) }}
					{{ form_errors(form.description) }}
				</div>
				<div class="d-flex justify-content-end gap-2 mt-3">
					<a href="{{ path('club_specialisations') }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-check me-2"></i>{{ 'create'|trans }}
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
