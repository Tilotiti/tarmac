{% extends 'club/base.html.twig' %}

{% form_theme form 'form/tags.html.twig' %}

{% block page_title %}
	{{ subTask.title }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_subtask_show', {taskId: task.id, id: subTask.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
			<i class="ti {{ task.equipment.type.icon }}"></i>
		</span>
		{{ task.equipment.name }} · {{ task.title }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-10 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-edit"></i>{{ 'editSubTask'|trans }}
				</div>
				{{ form_start(form) }}
				<div class="row">
					<div class="col-12 col-md-9 mb-3">
						{{ form_row(form.title) }}
					</div>
					<div class="col-12 col-md-3 mb-3">
						{{ form_row(form.difficulty) }}
					</div>
				</div>
				<div class="mb-3">
					{{ form_row(form.description, {'attr': {'rows': 3}}) }}
				</div>
				{% if form.specialisations is defined %}
					<div class="mb-3">
						{{ form_row(form.specialisations) }}
					</div>
				{% endif %}
				<div class="form-check form-switch mb-3">
					{{ form_widget(form.requiresInspection, {'attr': {'class': 'form-check-input'}}) }}
					{{ form_label(form.requiresInspection, null, {'label_attr': {'class': 'form-check-label'}}) }}
				</div>
				{% set subtaskDocumentationDeletePath = subTask.documentation ? path('club_subtask_delete_documentation', {taskId: task.id, id: subTask.id, _token: csrf_token('del_subtask_doc' ~ subTask.id)}) : null %}
				{% include 'component/documentationUploader.html.twig' with {
					field: form.documentation,
					existingUrl: subTask.documentation,
					deletePath: subtaskDocumentationDeletePath,
					deleteConfirmKey: 'confirmDeleteSubTaskDocumentation',
					lightboxGroup: 'subtask-documentation-' ~ subTask.id
				} %}

				<div class="d-flex justify-content-end gap-2 mt-3">
					<a href="{{ path('club_subtask_show', {taskId: task.id, id: subTask.id}) }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-check me-2"></i>{{ 'save'|trans }}
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
