{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ subTask.title }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_task_show', {id: task.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
			<i class="ti {{ task.equipment.type.icon }}"></i>
		</span>
		{{ task.equipment.name }} · {{ task.title }}
	</a>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		{% if is_granted('MANAGE') %}
			<form method="post" action="{{ path('club_subtask_toggle_priority', {taskId: task.id, id: subTask.id}) }}" class="d-inline">
				<input type="hidden" name="_token" value="{{ csrf_token('toggle_priority_subtask' ~ subTask.id) }}">
				<button type="submit"
					class="btn {{ subTask.isPriority() ? 'btn-warning' : 'btn-outline-secondary' }}"
					data-bs-toggle="tooltip"
					data-bs-placement="bottom"
					title="{{ subTask.isPriority() ? 'removePriority'|trans : 'markAsPriority'|trans }}">
					<i class="ti ti-flag me-2"></i>
					<span class="d-none d-sm-inline">{{ subTask.isPriority() ? 'priority'|trans : 'markAsPriority'|trans }}</span>
				</button>
			</form>
		{% endif %}

		{% if is_granted('SUBTASK_INSPECT', subTask) %}
			<form method="post" action="{{ path('club_subtask_inspect_approve', {taskId: task.id, id: subTask.id}) }}" class="d-inline">
				<button type="submit" class="btn btn-success">
					<i class="ti ti-circle-check me-2"></i>
					<span class="d-none d-sm-inline">{{ 'approveInspection'|trans }}</span>
				</button>
			</form>
			<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
				<i class="ti ti-circle-x me-2"></i>
				<span class="d-none d-sm-inline">{{ 'rejectInspection'|trans }}</span>
			</button>
		{% endif %}

		{% if is_granted('SUBTASK_REOPEN', subTask) and subTask.isClosed() and task.isOpen() %}
			<button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#reopenModal">
				<i class="ti ti-refresh me-2"></i>
				<span class="d-none d-sm-inline">{{ 'reopenSubTask'|trans }}</span>
			</button>
		{% endif %}

		{# Menu kebab : Modifier + Annuler (actions secondaires non-workflow) #}
		{% set canEdit = is_granted('SUBTASK_EDIT', subTask) %}
		{% set canCancel = is_granted('SUBTASK_CANCEL', subTask) and subTask.isOpen() %}
		{% if canEdit or canCancel %}
			<div class="dropdown d-inline-block" data-controller="dropdown">
				<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
					<i class="ti ti-dots-vertical"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
					{% if canEdit %}
						<a href="{{ path('club_subtask_edit', {taskId: task.id, id: subTask.id}) }}" class="dropdown-item">
							<i class="ti ti-edit me-2"></i>{{ 'edit'|trans }}
						</a>
					{% endif %}
					{% if canEdit and canCancel %}
						<div class="dropdown-divider"></div>
					{% endif %}
					{% if canCancel %}
						<button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelSubTaskModal">
							<i class="ti ti-ban me-2"></i>{{ 'cancelSubTask'|trans }}
						</button>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block page_content %}
	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">

			{# Bandeau de blocage (le user ne peut pas compléter — explication contextuelle) #}
			{% if completeFormBlockedReason is defined and completeFormBlockedReason %}
				<div class="alert alert-info mb-3">
					<i class="ti ti-info-circle me-2"></i>
					{{ completeFormBlockedReason|trans }}
				</div>
			{% endif %}

			{# Description #}
			{% if subTask.description %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-align-left"></i>
						{{ 'description'|trans }}
					</div>
					<div style="font-size:0.95rem;line-height:1.6;color:var(--td-ink);">
						{{ subTask.description|nl2br }}
					</div>
				</div>
			{% endif %}

			{# Documentation #}
			{% if subTask.documentation %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-paperclip"></i>
						{{ 'documentation'|trans }}
					</div>
					{% include 'component/documentationPreview.html.twig' with {
						url: subTask.documentation,
						lightboxGroup: 'subtask-documentation-' ~ subTask.id
					} %}
				</div>
			{% endif %}

			{# Formulaire 1 : Ma contribution rapide (tracker mon temps perso, sans clôturer) #}
			{% if contributionForm is defined and contributionForm is not null %}
				{% set alreadyContributed = contributionAlreadyExistsForCurrentUser|default(false) %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-clock-plus"></i>
						{{ 'myContribution'|trans }}
					</div>
					<p class="tarmac-form-hint">
						{% if alreadyContributed %}
							<i class="ti ti-check text-success me-1"></i>{{ 'myContributionAlreadySavedHint'|trans }}
						{% else %}
							{{ 'myContributionExplain'|trans }}
						{% endif %}
					</p>

					{{ form_start(contributionForm, {'action': path('club_subtask_contribution_add', {taskId: task.id, subTaskId: subTask.id})}) }}
					<div class="d-flex align-items-end flex-wrap gap-3">
						<div class="flex-fill" style="min-width: 240px;">
							{{ form_widget(contributionForm.timeSpent) }}
							{{ form_errors(contributionForm.timeSpent) }}
						</div>
						<div class="d-flex gap-2">
							<button type="submit" class="btn btn-primary">
								<i class="ti ti-{{ alreadyContributed ? 'check' : 'clock-plus' }} me-2"></i>
								{{ alreadyContributed ? 'updateMyTime'|trans : 'saveMyTime'|trans }}
							</button>
							{% if alreadyContributed %}
								<a href="{{ path('club_subtask_contribution_remove', {taskId: task.id, subTaskId: subTask.id, _token: csrf_token('remove_contribution_' ~ subTask.id)}) }}"
								   class="btn btn-outline-danger"
								   data-controller="confirm"
								   data-confirm-message-value="{{ 'removeMyContributionConfirm'|trans|default('Retirer ma contribution ?') }}">
									<i class="ti ti-trash me-1"></i>{{ 'removeMyContribution'|trans }}
								</a>
							{% endif %}
						</div>
					</div>
					{{ form_end(contributionForm) }}
				</div>
			{% endif %}

			{# Formulaire 2 : Clôturer la sous-tâche (cumul contributions équipe + valideur) #}
			{% if completeForm is defined and completeForm is not null %}
				<div class="tarmac-panel tarmac-panel--accent mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-circle-check"></i>
						{{ 'closeSubTaskTitle'|trans }}
					</div>
					<p class="tarmac-form-hint">
						{% if subTask.requiresInspection %}
							{{ 'closeSubTaskWithInspectionHint'|trans }}
						{% else %}
							{{ 'closeSubTaskHint'|trans }}
						{% endif %}
					</p>

					{{ form_start(completeForm, {'action': path('club_subtask_complete', {taskId: task.id, id: subTask.id})}) }}
						{% include 'component/subtask_complete_form_body.html.twig' with {
							completeForm: completeForm,
							contributionUsedMembershipIds: contributionUsedMembershipIds|default([]),
							contributionAllMembershipIds: contributionAllMembershipIds|default([]),
							showDoneByFilter: is_granted('MANAGE'),
							subTaskForTotal: subTask
						} %}
						<button type="submit" class="btn btn-success w-100 mt-3" style="min-height: 48px;">
							<i class="ti ti-check me-2"></i>
							{{ 'markAsDone'|trans }}
						</button>
					{{ form_end(completeForm) }}
				</div>
			{% endif %}

			{# Activity & comments (panel compact, comme task/show) #}
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-history"></i>
					{{ 'activity'|trans }}
				</div>

				{% if subTask.activities|length > 0 %}
					<ul class="tarmac-timeline">
						{% for activity in subTask.activities %}
							{% set iconVariant = activity.typeColor in ['success', 'green'] ? 'success'
								: activity.typeColor in ['warning', 'orange', 'yellow'] ? 'warning'
								: activity.typeColor in ['danger', 'red'] ? 'danger'
								: activity.typeColor in ['azure', 'cyan', 'info'] ? 'azure'
								: activity.typeColor == 'purple' ? 'purple'
								: '' %}
							<li class="tarmac-timeline__item">
								<span class="tarmac-timeline__icon{% if iconVariant %} tarmac-timeline__icon--{{ iconVariant }}{% endif %}">
									<i class="ti {{ activity.typeIcon }}"></i>
								</span>
								<div class="tarmac-timeline__head">
									<span class="tarmac-timeline__author">{{ activity.user.fullName }}</span>
									<span class="tarmac-timeline__action">{{ activity.typeLabel|trans|lower }}</span>
									<span class="tarmac-timeline__date">{{ activity.createdAt|date('d/m/Y H:i') }}</span>
								</div>
								{% if activity.message %}
									<div class="tarmac-timeline__body">{{ activity.message|nl2br }}</div>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				{% else %}
					<p class="text-secondary" style="margin:0;font-size:0.9rem;">
						<em>{{ 'noActivityYet'|trans }}</em>
					</p>
				{% endif %}

				{# Comment form #}
				{% if commentForm is defined and commentForm is not null %}
					<hr style="border-color: var(--td-border); margin: 1.25rem 0;">
					{{ form_start(commentForm) }}
						<label for="{{ commentForm.message.vars.id }}" class="form-label">
							<i class="ti ti-message me-1"></i>{{ 'addComment'|trans }}
						</label>
						<div class="mb-3">
							{{ form_widget(commentForm.message) }}
						</div>
						<button type="submit" class="btn btn-primary btn-sm">
							<i class="ti ti-send me-1"></i>
							{{ 'addComment'|trans }}
						</button>
					{{ form_end(commentForm) }}
				{% endif %}
			</div>

		</div>{# /col-12 col-lg-8 (main) #}

		{# ========== Sidebar ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">

				{# Panel : tâche parente #}
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-checklist"></i>
						{{ 'parentTask'|trans }}
					</div>
					<a href="{{ path('club_task_show', {id: task.id}) }}"
					   style="display:flex;align-items:center;gap:0.75rem;text-decoration:none;color:var(--td-ink);">
						<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
							<i class="ti {{ task.equipment.type.icon }}"></i>
						</span>
						<div style="min-width:0;flex:1;">
							<div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--td-ink-3);">
								{{ task.equipment.name }}
							</div>
							<div style="font-weight:700;color:var(--td-deep);">
								{{ task.title }}
							</div>
						</div>
					</a>
					{% if task.dueAt %}
						<div class="mt-2" style="font-size:0.82rem;color:var(--td-ink-2);">
							<i class="ti ti-calendar me-1"></i>{{ 'dueAt'|trans }} : {{ task.dueAt|date('d/m/Y') }}
						</div>
					{% endif %}
					{% if task.planApplication %}
						<div class="mt-1" style="font-size:0.82rem;color:var(--td-ink-2);">
							<i class="ti ti-file-check me-1"></i>
							<a href="{{ path('club_plan_application_show', {id: task.planApplication.id}) }}" style="color:var(--td-mid);font-weight:500;">
								{{ task.planApplication.plan.name }}
							</a>
						</div>
					{% endif %}
				</div>

				{# Panel : détails de la sous-tâche #}
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>
						{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'status'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% if subTask.isWaitingForApproval %}
									<span class="tarmac-badge tarmac-badge--status-inspection">
										<i class="ti ti-hourglass"></i>
										{{ 'waitingForApproval'|trans }}
									</span>
								{% elseif subTask.status == 'closed' %}
									<span class="tarmac-badge tarmac-badge--status-closed">
										<i class="ti ti-circle-check"></i>
										{{ subTask.status|trans }}
									</span>
								{% elseif subTask.status == 'cancelled' %}
									<span class="tarmac-badge tarmac-badge--status-cancelled">
										<i class="ti ti-x"></i>
										{{ subTask.status|trans }}
									</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--status-open">
										<i class="ti ti-circle"></i>
										{{ subTask.status|trans }}
									</span>
								{% endif %}
							</span>
						</li>

						<li>
							<span class="tarmac-meta-list__label">{{ 'difficulty'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% include 'component/difficultyBadge.html.twig' with {'difficulty': subTask.difficulty} %}
							</span>
						</li>

						{% if subTask.requiresInspection %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'inspection'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<span class="tarmac-badge tarmac-badge--glow" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'requiresValidationTooltip'|trans }}">
										<i class="ti ti-shield-check"></i>
										{{ 'requiresInspection'|trans }}
									</span>
								</span>
							</li>
						{% endif %}

						{% if subTask.specialisations|length > 0 %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'specialisations'|trans }}</span>
								<span class="tarmac-meta-list__value" style="display:flex;flex-wrap:wrap;gap:0.3rem;justify-content:flex-end;">
									{% for spec in subTask.specialisations %}
										<span class="tarmac-badge tarmac-badge--specialisation" title="{{ spec.description|default('')|e('html_attr') }}">
											<i class="ti ti-tag"></i>{{ spec.name }}
										</span>
									{% endfor %}
								</span>
							</li>
						{% endif %}

						{% if subTask.doneBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'doneBy'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ subTask.doneBy.fullName }}</span>
							</li>
						{% endif %}

						{% if subTask.doneAt %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'doneAt'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ subTask.doneAt|date('d/m/Y H:i') }}</span>
							</li>
						{% endif %}

						{% if subTask.inspectedBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'inspectedBy'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ subTask.inspectedBy.fullName }}</span>
							</li>
						{% endif %}

						{% if subTask.inspectedAt %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'inspectedAt'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ subTask.inspectedAt|date('d/m/Y H:i') }}</span>
							</li>
						{% endif %}
					</ul>
				</div>

				{# Panel : temps & contributions #}
				{% if subTask.contributions|length > 0 %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-clock"></i>
							{{ 'timeTracking'|trans }}
							<span class="tarmac-section-bar__count" style="margin-left:auto;">{{ subTask.totalTimeSpent|format_time_spent }}</span>
						</div>
						<ul class="tarmac-contributors">
							{% for contribution in subTask.contributions %}
								{% set contributor = contribution.membership.user %}
								<li class="tarmac-contributors__item">
									<span class="contributor-avatar contributor-avatar--c{{ contributor.id % 8 }}">
										{{ contributor.firstname|default('')|slice(0, 1)|upper }}{{ contributor.lastname|default('')|slice(0, 1)|upper }}
									</span>
									<span class="tarmac-contributors__name">{{ contributor.fullName|default(contributor.email) }}</span>
									<span class="tarmac-contributors__time">
										<i class="ti ti-clock"></i>{{ contribution.timeSpent|format_time_spent }}
									</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

			</div>
		</div>

	</div>{# /row g-3 #}

	{# ========== Modales (au root pour éviter les conflits z-index) ========== #}

	{# Reject Modal #}
	{% if is_granted('SUBTASK_INSPECT', subTask) %}
		<div class="modal fade" id="rejectModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ 'rejectInspection'|trans }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form method="post" action="{{ path('club_subtask_inspect_reject', {taskId: task.id, id: subTask.id}) }}">
						<input type="hidden" name="activity_form[_token]" value="{{ csrf_token('activity_form') }}">
						<div class="modal-body">
							<div class="mb-3">
								<label class="form-label">{{ 'rejectionReason'|trans }} *</label>
								<textarea name="activity_form[message]" class="form-control" rows="3" placeholder="{{ 'explainReason'|trans }}" required></textarea>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'cancel'|trans }}</button>
							<button type="submit" class="btn btn-danger">{{ 'rejectInspection'|trans }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endif %}

	{# Reopen Modal #}
	{% if is_granted('SUBTASK_REOPEN', subTask) and subTask.isClosed() and task.isOpen() %}
		<div class="modal fade" id="reopenModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ 'reopenSubTask'|trans }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form method="post" action="{{ path('club_subtask_reopen', {taskId: task.id, id: subTask.id}) }}">
						<input type="hidden" name="activity_form[_token]" value="{{ csrf_token('activity_form') }}">
						<div class="modal-body">
							<div class="mb-3">
								<label class="form-label">{{ 'reopenReason'|trans }}</label>
								<textarea name="activity_form[message]" class="form-control" rows="3" placeholder="{{ 'optionalReason'|trans }}"></textarea>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'cancel'|trans }}</button>
							<button type="submit" class="btn btn-outline-secondary">{{ 'reopenSubTask'|trans }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endif %}

	{# Cancel SubTask Modal #}
	{% if is_granted('SUBTASK_CANCEL', subTask) and subTask.isOpen() %}
		<div class="modal fade" id="cancelSubTaskModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ 'cancelSubTask'|trans }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form method="post" action="{{ path('club_subtask_cancel', {taskId: task.id, id: subTask.id}) }}">
						<input type="hidden" name="activity_form[_token]" value="{{ csrf_token('activity_form') }}">
						<div class="modal-body">
							<div class="mb-3">
								<label class="form-label">{{ 'cancellationReason'|trans }}</label>
								<textarea name="activity_form[message]" class="form-control" rows="3" placeholder="{{ 'optionalReason'|trans }}"></textarea>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'cancel'|trans }}</button>
							<button type="submit" class="btn btn-danger">{{ 'cancelSubTask'|trans }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
