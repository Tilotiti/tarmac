{% extends 'club/base.html.twig' %}

{% form_theme form 'form/tags.html.twig' %}

{% block page_title %}
	{{ 'newSubTask'|trans }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_task_show', {id: task.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
			<i class="ti {{ task.equipment.type.icon }}"></i>
		</span>
		{{ task.equipment.name }} · {{ task.title }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-10 mx-auto">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-plus"></i>{{ 'newSubTask'|trans }}
				</div>
				{{ form_start(form) }}
				{{ form_row(form.title) }}
				{{ form_row(form.description) }}
				{% if form.specialisations is defined %}
					<div class="mb-3">
						{{ form_row(form.specialisations) }}
					</div>
				{% endif %}
				<div class="row">
					<div class="col-12 col-md-6 mb-3">
						{{ form_row(form.difficulty) }}
					</div>
					<div class="col-12 col-md-6 mb-3">
						{{ form_row(form.requiresInspection) }}
					</div>
				</div>
				{% if form.insertPosition is defined %}
					<div class="mb-3">
						{{ form_row(form.insertPosition) }}
					</div>
				{% endif %}
				{% include 'component/documentationUploader.html.twig' with {
					field: form.documentation,
					existingUrl: null,
					lightboxGroup: 'subtask-documentation',
					emptyTextKey: 'clickToUploadDocumentation',
					deletePath: null
				} %}

				<div class="d-flex justify-content-end gap-2 mt-3">
					<a href="{{ path('club_task_show', {id: task.id}) }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-check me-2"></i>{{ 'save'|trans }}
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
