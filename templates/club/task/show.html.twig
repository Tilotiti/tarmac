{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ task.title }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_equipment_show', {id: task.equipment.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
			<i class="ti {{ task.equipment.type.icon }}"></i>
		</span>
		{{ task.equipment.name }}
	</a>
{% endblock %}

{% block page_actions %}
	<div class="btn-list">
		{% if is_granted('MANAGE') %}
			<form method="post" action="{{ path('club_task_toggle_priority', {id: task.id}) }}" class="d-inline">
				<input type="hidden" name="_token" value="{{ csrf_token('toggle_priority_task' ~ task.id) }}">
				<button type="submit"
					class="btn {{ task.isPriority() ? 'btn-warning' : 'btn-outline-secondary' }}"
					data-bs-toggle="tooltip"
					data-bs-placement="bottom"
					title="{{ task.isPriority() ? 'removePriority'|trans : 'markAsPriority'|trans }}">
					<i class="ti ti-flag me-2"></i>
					<span class="d-none d-sm-inline">{{ task.isPriority() ? 'priority'|trans : 'markAsPriority'|trans }}</span>
				</button>
			</form>
		{% endif %}

		{# Close task button - voter handles all validation (status, subtasks, permissions, etc.) #}
		{% if is_granted('TASK_CLOSE', task) %}
			<form method="post" action="{{ path('club_task_close', {id: task.id}) }}" class="d-inline">
				<button type="submit" class="btn btn-success">
					<i class="ti ti-check me-2"></i>
					<span class="d-none d-sm-inline">{{ 'closeTask'|trans }}</span>
				</button>
			</form>
		{% endif %}

		{# Menu kebab : Modifier + Annuler (actions secondaires non-workflow) #}
		{% set canEdit = is_granted('TASK_EDIT', task) %}
		{% set canCancel = is_granted('TASK_CANCEL', task) %}
		{% if canEdit or canCancel %}
			<div class="dropdown d-inline-block" data-controller="dropdown">
				<button type="button" class="btn btn-outline-secondary" data-dropdown-target="toggle" aria-haspopup="true" aria-expanded="false" title="{{ 'moreActions'|trans }}">
					<i class="ti ti-dots-vertical"></i>
				</button>
				<div class="dropdown-menu dropdown-menu-end" data-dropdown-target="menu">
					{% if canEdit %}
						<a href="{{ path('club_task_edit', {id: task.id}) }}" class="dropdown-item">
							<i class="ti ti-edit me-2"></i>{{ 'edit'|trans }}
						</a>
					{% endif %}
					{% if canEdit and canCancel %}
						<div class="dropdown-divider"></div>
					{% endif %}
					{% if canCancel %}
						<button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
							<i class="ti ti-ban me-2"></i>{{ 'cancelTask'|trans }}
						</button>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block page_content %}
	{# Calcule la progression dès maintenant (utilisée à la fois dans le header section et dans la sidebar) #}
	{% set totalSubTasks = 0 %}
	{% set closedSubTasks = 0 %}
	{% if task.subTasks|length > 0 %}
		{% for subtask in task.subTasks %}
			{% if subtask.status != 'cancelled' %}
				{% set totalSubTasks = totalSubTasks + 1 %}
				{% if subtask.status == 'closed' %}
					{% set closedSubTasks = closedSubTasks + 1 %}
				{% endif %}
			{% endif %}
		{% endfor %}
	{% endif %}
	{% set progress = totalSubTasks > 0 ? (closedSubTasks / totalSubTasks * 100)|round : 100 %}

	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">

			{# Description #}
			{% if task.description %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-align-left"></i>
						{{ 'description'|trans }}
					</div>
					<div style="font-size:0.95rem;line-height:1.6;color:var(--td-ink);">
						{{ task.description|nl2br }}
					</div>
				</div>
			{% endif %}

			{# Documentation #}
			{% if task.documentation %}
				<div class="tarmac-panel mb-3">
					<div class="tarmac-panel__title">
						<i class="ti ti-paperclip"></i>
						{{ 'documentation'|trans }}
					</div>
					{% include 'component/documentationPreview.html.twig' with {
						url: task.documentation,
						lightboxGroup: 'task-documentation-' ~ task.id
					} %}
				</div>
			{% endif %}

			{# SubTasks Section - sélection multiple + actions groupées #}
			<div
				class="mb-4"
				data-controller="subtask-bulk-selection subtask-reorder"
				data-action="subtask-reorder:start->subtask-bulk-selection#exitSelectionMode subtask-bulk-selection:start->subtask-reorder#exit"
		data-subtask-reorder-reorderStart-value="{{ 'reorderSubTasks'|trans }}"
		data-subtask-reorder-reorderCancel-value="{{ 'cancelReorder'|trans }}"
		data-subtask-bulk-selection-bulk-add-contribution-url-value="{{ path('club_subtasks_bulk_add_contribution', {taskId: task.id}) }}"
		data-subtask-bulk-selection-bulk-close-url-value="{{ path('club_subtasks_bulk_close', {taskId: task.id}) }}"
		data-subtask-bulk-selection-bulk-cancel-url-value="{{ path('club_subtasks_bulk_cancel', {taskId: task.id}) }}"
		{% if is_granted('MANAGE') %}data-subtask-bulk-selection-bulk-toggle-priority-url-value="{{ path('club_subtasks_bulk_toggle_priority', {taskId: task.id}) }}"{% endif %}
		data-subtask-bulk-selection-enterTotalTimeMinutes-value="{{ 'enterTotalTimeMinutes'|trans }}"
		data-subtask-bulk-selection-enterCancellationReason-value="{{ 'cancellationReason'|trans }}"
		data-subtask-bulk-selection-bulkSelectionStart-value="{{ 'selectSubTasks'|trans }}"
		data-subtask-bulk-selection-bulkSelectionCancel-value="{{ 'cancelSelection'|trans }}"
	>
		<div class="tarmac-section-bar">
			<h3 class="tarmac-section-bar__title">
				<i class="ti ti-list-check"></i>
				{{ 'subTasks'|trans }}
				<span class="tarmac-section-bar__count">{{ filteredSubTasks|length }}</span>
			</h3>

			{# Progression inline — fusionnée avec le header de section #}
			{% if totalSubTasks > 0 %}
				<div class="tarmac-section-bar__progress">
					<div class="tarmac-progress{% if progress == 100 %} tarmac-progress--done{% endif %}">
						<span style="width: {{ progress }}%"></span>
					</div>
					<span class="tarmac-section-bar__progress-text">
						<strong>{{ closedSubTasks }}</strong> / {{ totalSubTasks }} · {{ progress }} %
					</span>
				</div>
			{% endif %}

			<div class="tarmac-section-bar__actions">
				{% if filteredSubTasks|length > 0 %}
					<button
						type="button"
						class="btn btn-outline-secondary btn-sm"
						data-subtask-bulk-selection-target="selectToggle"
						data-action="click->subtask-bulk-selection#toggleSelectionMode"
						title="{{ 'selectSubTasks'|trans }}"
					>
						<i
							class="ti ti-list-check me-1"
							data-subtask-bulk-selection-target="selectIcon"
						></i>
						<span class="btn-text" data-subtask-bulk-selection-target="selectLabel">
							{{ 'selectSubTasks'|trans }}
						</span>
					</button>
				{% endif %}
				{% if is_granted('TASK_EDIT', task) and filteredSubTasks|length > 1 %}
					<button
						type="button"
						class="btn btn-outline-secondary btn-sm"
						data-subtask-reorder-target="toggle"
						data-action="click->subtask-reorder#toggleReorderMode"
						title="{{ 'reorderSubTasks'|trans }}"
					>
						<i
							class="ti ti-arrows-sort me-1"
							data-subtask-reorder-target="icon"
						></i>
						<span class="btn-text" data-subtask-reorder-target="label">
							{{ 'reorderSubTasks'|trans }}
						</span>
					</button>
				{% endif %}
				{% if is_granted('TASK_CREATE_SUBTASK', task) %}
					<a href="{{ path('club_subtask_new', {taskId: task.id}) }}" class="btn btn-primary btn-sm">
						<i class="ti ti-plus me-1"></i>
						<span class="btn-text">{{ 'newSubTask'|trans }}</span>
					</a>
				{% endif %}
			</div>
		</div>

		{% if task.subTasks|length > 0 %}
			<div class="mb-3">
				{% include 'component/filters.html.twig' with { form: filters, style: 'small' } %}
			</div>
		{% endif %}

		<div data-subtask-bulk-selection-target="subtaskList" data-subtask-reorder-target="list">
			{% for subtask in filteredSubTasks %}
				<div
					class="mb-3 subtask-bulk-item-wrapper"
					data-subtask-bulk-selection-target="item"
					data-subtask-bulk-selection-id-value="{{ subtask.id }}"
					data-subtask-reorder-target="item"
					data-subtask-reorder-id-value="{{ subtask.id }}"
				>
					{% if is_granted('TASK_EDIT', task) %}
						<div class="subtask-reorder-handle" aria-hidden="true">
							<i class="ti ti-grip-vertical"></i>
						</div>
					{% endif %}
					<a
						href="{{ path('club_subtask_show', {taskId: task.id, id: subtask.id}) }}"
						class="tarmac-card{% if subtask.status == 'cancelled' %} tarmac-card--dimmed{% endif %}"
						data-action="click->subtask-bulk-selection#onItemClick"
						role="article"
						aria-label="{{ subtask.title }} - {{ subtask.status|trans }}"
					>
						<div class="d-flex align-items-start">
							<div class="subtask-bulk-checkbox me-3">
								<div
									class="form-check"
									data-subtask-bulk-selection-target="checkbox"
								>
									<input
										class="form-check-input"
										type="checkbox"
										value="{{ subtask.id }}"
										data-action="click->subtask-bulk-selection#onCheckboxClick"
									>
								</div>
							</div>

							<div class="flex-grow-1">
								<h3 class="tarmac-card__title mb-1">
									{{ subtask.title }}
									{% if subtask.documentation %}
										<i class="ti ti-file-description text-secondary ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'documentationAvailable'|trans }}"></i>
									{% endif %}
								</h3>

								{# Status tag explicite + attributs #}
								<div class="tarmac-card__badges" style="margin-top:0.3rem;">
									{# Statut — toujours visible, premier badge #}
									{% if subtask.isWaitingForApproval %}
										<span class="tarmac-badge tarmac-badge--status-inspection">
											<i class="ti ti-hourglass"></i>
											{{ 'waitingForApproval'|trans }}
										</span>
									{% elseif subtask.status == 'closed' %}
										<span class="tarmac-badge tarmac-badge--status-closed">
											<i class="ti ti-circle-check"></i>
											{{ subtask.status|trans }}
										</span>
									{% elseif subtask.status == 'cancelled' %}
										<span class="tarmac-badge tarmac-badge--status-cancelled">
											<i class="ti ti-x"></i>
											{{ subtask.status|trans }}
										</span>
									{% elseif subtask.contributions|length > 0 %}
										<span class="tarmac-badge tarmac-badge--started">
											<i class="ti ti-clock-play"></i>
											{{ 'started'|trans }}
										</span>
									{% else %}
										<span class="tarmac-badge tarmac-badge--status-open">
											<i class="ti ti-circle"></i>
											{{ subtask.status|trans }}
										</span>
									{% endif %}

									{% if subtask.isPriority %}
										<span class="tarmac-badge tarmac-badge--priority">
											<i class="ti ti-flag"></i>
											{{ 'priority'|trans }}
										</span>
									{% endif %}

									{# Qualif. requise — uniquement si encore en open (sinon le statut porte déjà l'info) #}
									{% if subtask.requiresInspection and subtask.status == 'open' and not subtask.isWaitingForApproval %}
										<span class="tarmac-badge tarmac-badge--glow" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'requiresValidationTooltip'|trans }}">
											<i class="ti ti-shield-check"></i>
											{{ 'requiresInspection'|trans }}
										</span>
									{% endif %}

									{% include 'component/difficultyBadge.html.twig' with {'difficulty': subtask.difficulty} %}

									{% for spec in subtask.specialisations %}
										<span class="tarmac-badge tarmac-badge--specialisation" title="{{ spec.description|default('')|e('html_attr') }}">
											<i class="ti ti-tag"></i>
											{{ spec.name }}
										</span>
									{% endfor %}
								</div>

								{% if subtask.description %}
									<div class="tarmac-card__meta mt-2" style="font-size:0.88rem;color:var(--td-ink-2);">
										{{ subtask.description }}
									</div>
								{% endif %}
							</div>
						</div>

						{# Footer — contributions + avatars, avec séparateur en pointillés #}
						{% if subtask.contributions|length > 0 %}
							<div class="tarmac-card__footer d-flex align-items-center justify-content-between gap-2">
								<span class="tarmac-card__meta">
									<i class="ti ti-clock-play"></i>
									{{ subtask.contributions|length }}
									{{ (subtask.contributions|length > 1 ? 'contributions' : 'contribution')|trans|lower }}
								</span>
								{% include 'component/contributorAvatars.html.twig' with {'contributors': subtask.contributors} only %}
							</div>
						{% endif %}
					</a>
				</div>
			{% else %}
				<p class="text-center text-secondary mb-0">
					<em>{{ 'noSubTasksFound'|trans }}</em>
				</p>
			{% endfor %}
		</div>

		{# Barre de validation flottante du mode « Réorganiser » — même style que la barre de sélection #}
		{% if is_granted('TASK_EDIT', task) and filteredSubTasks|length > 1 %}
			<div
				class="subtask-reorder-actions d-none"
				data-subtask-reorder-target="actionsBar"
			>
				<div class="card shadow-lg">
					<div class="card-body d-flex align-items-center gap-2">
						<div class="me-2 text-secondary" style="font-size:0.85rem;">
							<i class="ti ti-arrows-sort me-1"></i>
							{{ 'dragToReorder'|trans }}
						</div>

						<div class="d-flex flex-wrap gap-2 ms-auto">
							<button
								type="button"
								class="btn btn-outline-secondary btn-sm"
								data-action="click->subtask-reorder#exit"
							>
								{{ 'cancel'|trans }}
							</button>

							<button
								type="button"
								class="btn btn-primary btn-sm"
								data-action="click->subtask-reorder#save"
							>
								<i class="ti ti-check me-1"></i>
								{{ 'saveOrder'|trans }}
							</button>
						</div>
					</div>
				</div>
			</div>

			{# Formulaire caché : le contrôleur y injecte les identifiants dans le nouvel ordre #}
			<form
				id="subtaskReorderForm"
				class="d-none"
				data-turbo="false"
				data-subtask-reorder-target="form"
				method="post"
				action="{{ path('club_subtasks_bulk_reorder', {taskId: task.id}) }}"
			>
				<input type="hidden" name="_token" value="{{ csrf_token('bulk_reorder_subtasks_' ~ task.id) }}">
			</form>
		{% endif %}

		{# Barre d'actions flottante pour les actions multiples #}
		<div
			class="subtask-bulk-actions d-none"
			data-subtask-bulk-selection-target="actionsBar"
		>
			<div class="card shadow-lg">
				<div class="card-body d-flex align-items-center gap-2">
					<div class="me-2">
						<span class="badge bg-primary-lt text-white">
							<span data-subtask-bulk-selection-target="counter">0</span>
							{{ 'subTasks'|trans|lower }}
						</span>
					</div>

					<div class="d-flex flex-wrap gap-2 ms-auto">
						<button
							type="button"
							class="btn btn-outline-secondary btn-sm"
							data-action="click->subtask-bulk-selection#exitSelectionMode"
						>
							{{ 'cancel'|trans }}
						</button>

						<button
							type="button"
							class="btn btn-primary btn-sm"
							data-action="click->subtask-bulk-selection#openBulkAddContributionModal"
						>
							<i class="ti ti-clock-plus me-1"></i>
							{{ 'addContribution'|trans }}
						</button>

						<button
							type="button"
							class="btn btn-success btn-sm"
							data-action="click->subtask-bulk-selection#openBulkCloseModal"
						>
							<i class="ti ti-check me-1"></i>
							{{ 'closeSubTasks'|trans }}
						</button>

						{% if is_granted('MANAGE') %}
							<button
								type="button"
								class="btn btn-warning btn-sm"
								data-action="click->subtask-bulk-selection#submitBulkTogglePriority"
							>
								<i class="ti ti-flag me-1"></i>
								{{ 'togglePriority'|trans }}
							</button>
						{% endif %}

						<button
							type="button"
							class="btn btn-outline-danger btn-sm"
							data-action="click->subtask-bulk-selection#openBulkCancelModal"
						>
							<i class="ti ti-ban me-1"></i>
							{{ 'cancelSubTasks'|trans }}
						</button>
					</div>
				</div>
			</div>
		</div>

		{# Modale : ajouter ma contribution en masse — doit être DANS le scope du controller Stimulus #}
		<div class="modal fade" id="bulkAddContributionModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">{{ 'addMyContribution'|trans }}</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cancel'|trans }}"></button>
				</div>
				{{ form_start(bulkContributionForm, {
					action: path('club_subtasks_bulk_add_contribution', {taskId: task.id}),
					attr: {
						id: 'bulkAddContributionForm',
						'data-turbo': 'false',
						'data-action': 'submit->subtask-bulk-selection#prepareBulkAddContribution'
					}
				}) }}
					<div class="modal-body">
						<div class="mb-2">
							{{ form_row(bulkContributionForm.timeSpent) }}
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="min-height: 44px;">
							{{ 'cancel'|trans }}
						</button>
						<button
							type="submit"
							class="btn btn-primary"
							style="min-height: 44px;"
						>
							<i class="ti ti-clock-plus me-2"></i>
							{{ 'addMyContribution'|trans }}
						</button>
					</div>
				{{ form_end(bulkContributionForm) }}
			</div>
		</div>
	</div>

	{# Modale : clore en masse - même UI que formulaire complete sous-tâche unitaire #}
	{% if bulkCloseForm is defined and bulkCloseForm is not null %}
	<div class="modal fade" id="bulkCloseModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">{{ 'closeSubTasks'|trans }}</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cancel'|trans }}"></button>
				</div>
				{{ form_start(bulkCloseForm, {
					action: path('club_subtasks_bulk_close', {taskId: task.id}),
					attr: {
						id: 'bulkCloseForm',
						'data-turbo': 'false',
						'data-action': 'submit->subtask-bulk-selection#prepareBulkClose'
					}
				}) }}
					<div class="modal-body">
						{% include 'component/subtask_complete_form_body.html.twig' with {
							completeForm: bulkCloseForm,
							contributionUsedMembershipIds: bulkCloseContributionUsedMembershipIds|default([]),
							contributionAllMembershipIds: bulkCloseContributionAllMembershipIds|default([]),
							showDoneByFilter: is_granted('MANAGE')
						} %}
						{# Token CSRF uniquement (doneBy + contributions déjà rendus dans le partial) #}
						{{ form_widget(bulkCloseForm._token) }}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="min-height: 44px;">
							{{ 'cancel'|trans }}
						</button>
						<button type="submit" class="btn btn-success" style="min-height: 44px;">
							{{ 'confirm'|trans }}
						</button>
					</div>
				{{ form_end(bulkCloseForm, {'render_rest': false}) }}
			</div>
		</div>
	</div>
	{% endif %}

	{# Modale : annuler en masse #}
	<div class="modal fade" id="bulkCancelModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">{{ 'cancelSubTasks'|trans }}</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cancel'|trans }}"></button>
				</div>
				{{ form_start(bulkCancelForm, {
					action: path('club_subtasks_bulk_cancel', {taskId: task.id}),
					attr: {
						id: 'bulkCancelForm',
						'data-turbo': 'false',
						'data-action': 'submit->subtask-bulk-selection#prepareBulkCancel'
					}
				}) }}
					<div class="modal-body">
						{{ form_row(bulkCancelForm.message) }}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="min-height: 44px;">
							{{ 'cancel'|trans }}
						</button>
						<button type="submit" class="btn btn-outline-danger" style="min-height: 44px;">
							<i class="ti ti-ban me-2"></i>
							{{ 'confirm'|trans }}
						</button>
					</div>
				{{ form_end(bulkCancelForm) }}
			</div>
		</div>
	</div>

	{% if is_granted('MANAGE') %}
		<form
			id="bulkTogglePriorityForm"
			method="post"
			action="{{ path('club_subtasks_bulk_toggle_priority', {taskId: task.id}) }}"
			data-turbo="false"
			data-action="submit->subtask-bulk-selection#prepareBulkTogglePriority"
			class="d-none"
		>
			<input type="hidden" name="_token" value="{{ csrf_token('bulk_toggle_priority_subtasks_' ~ task.id) }}">
		</form>
	{% endif %}
		</div>{# /subtask-bulk-selection wrapper #}

		{# Activity & comments (panel compact, dans la colonne principale) #}
		<div class="tarmac-panel">
			<div class="tarmac-panel__title">
				<i class="ti ti-history"></i>
				{{ 'activity'|trans }}
			</div>

			{% if task.mainActivities|length > 0 %}
				<ul class="tarmac-timeline">
					{% for activity in task.mainActivities %}
						{% set iconVariant = activity.typeColor in ['success', 'green'] ? 'success'
							: activity.typeColor in ['warning', 'orange', 'yellow'] ? 'warning'
							: activity.typeColor in ['danger', 'red'] ? 'danger'
							: activity.typeColor in ['azure', 'cyan', 'info'] ? 'azure'
							: activity.typeColor == 'purple' ? 'purple'
							: '' %}
						<li class="tarmac-timeline__item">
							<span class="tarmac-timeline__icon{% if iconVariant %} tarmac-timeline__icon--{{ iconVariant }}{% endif %}">
								<i class="ti {{ activity.typeIcon }}"></i>
							</span>
							<div class="tarmac-timeline__head">
								<span class="tarmac-timeline__author">{{ activity.user.fullName }}</span>
								<span class="tarmac-timeline__action">{{ activity.typeLabel|trans|lower }}</span>
								<span class="tarmac-timeline__date">{{ activity.createdAt|date('d/m/Y H:i') }}</span>
							</div>
							{% if activity.subTask %}
								<div class="tarmac-timeline__context">
									<i class="ti ti-arrow-right me-1"></i>{{ activity.subTask.title }}
								</div>
							{% endif %}
							{% if activity.message %}
								<div class="tarmac-timeline__body">{{ activity.message|nl2br }}</div>
							{% endif %}
						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p class="text-secondary" style="margin:0;font-size:0.9rem;">
					<em>{{ 'noActivityYet'|trans }}</em>
				</p>
			{% endif %}

			{# Comment form #}
			{% if commentForm is defined %}
				<hr style="border-color: var(--td-border); margin: 1.25rem 0;">
				{{ form_start(commentForm, {action: path('club_task_comment', {id: task.id})}) }}
					<label for="{{ commentForm.message.vars.id }}" class="form-label">
						<i class="ti ti-message me-1"></i>{{ 'addComment'|trans }}
					</label>
					<div class="mb-3">
						{{ form_widget(commentForm.message) }}
					</div>
					<button type="submit" class="btn btn-primary btn-sm">
						<i class="ti ti-send me-1"></i>
						{{ 'addComment'|trans }}
					</button>
				{{ form_end(commentForm) }}
			{% endif %}
		</div>

		</div>{# /col-12 col-lg-8 (main) #}

		{# ========== Sidebar — métadonnées de la tâche ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-info-circle"></i>
						{{ 'details'|trans }}
					</div>
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'status'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% if task.isWaitingForApproval %}
									<span class="tarmac-badge tarmac-badge--status-inspection">
										<i class="ti ti-hourglass"></i>
										{{ 'waitingForApproval'|trans }}
									</span>
								{% elseif task.status == 'cancelled' %}
									<span class="tarmac-badge tarmac-badge--status-cancelled">
										<i class="ti ti-x"></i>
										{{ task.status|trans }}
									</span>
								{% elseif task.status == 'closed' %}
									<span class="tarmac-badge tarmac-badge--status-closed">
										<i class="ti ti-circle-check"></i>
										{{ task.status|trans }}
									</span>
								{% else %}
									<span class="tarmac-badge tarmac-badge--status-open">
										<i class="ti ti-circle"></i>
										{{ task.status|trans }}
									</span>
								{% endif %}
							</span>
						</li>

						<li>
							<span class="tarmac-meta-list__label">{{ 'difficulty'|trans }}</span>
							<span class="tarmac-meta-list__value">
								{% include 'component/difficultyBadge.html.twig' with {'label': task.difficultyLabel, 'color': task.difficultyColor} %}
							</span>
						</li>

						{% if task.requiresInspection %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'inspection'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<span class="tarmac-badge tarmac-badge--status-inspection" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'requiresValidationTooltip'|trans }}">
										<i class="ti ti-shield-check"></i>
										{{ 'requiresInspection'|trans }}
									</span>
								</span>
							</li>
						{% endif %}

						{% if task.dueAt %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'dueDate'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-calendar me-1 text-secondary"></i>{{ task.dueAt|date('d/m/Y') }}
								</span>
							</li>
						{% endif %}

						{% if task.totalTimeSpent > 0 %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'totalTimeSpent'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-clock me-1 text-secondary"></i>{{ task.totalTimeSpent|format_time_spent }}
								</span>
							</li>
						{% endif %}

						{% if task.createdBy %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'createdBy'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ task.createdBy.fullName }}</span>
							</li>
						{% endif %}

						<li>
							<span class="tarmac-meta-list__label">{{ 'createdAt'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ task.createdAt|date('d/m/Y H:i') }}</span>
						</li>

						{% if task.equipment.responsible %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'responsible'|trans }}</span>
								<span class="tarmac-meta-list__value">
									<i class="ti ti-user-shield me-1 text-secondary"></i>{{ task.equipment.responsible.fullname }}
								</span>
							</li>
						{% endif %}
					</ul>
				</div>

				{# Contributeurs — qui a travaillé sur cette tâche, et combien de temps #}
				{% set contributorStats = task.contributorsWithTime %}
				{% if contributorStats|length > 0 %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-users"></i>
							{{ 'contributors'|trans }}
							<span class="tarmac-section-bar__count" style="margin-left:auto;">{{ contributorStats|length }}</span>
						</div>
						<ul class="tarmac-contributors">
							{% for stat in contributorStats %}
								<li class="tarmac-contributors__item">
									<span class="contributor-avatar contributor-avatar--c{{ stat.user.id % 8 }}">
										{{ stat.user.firstname|default('')|slice(0, 1)|upper }}{{ stat.user.lastname|default('')|slice(0, 1)|upper }}
									</span>
									<span class="tarmac-contributors__name">{{ stat.user.fullName|default(stat.user.email) }}</span>
									<span class="tarmac-contributors__time">
										<i class="ti ti-clock"></i>
										{{ stat.timeSpent|format_time_spent }}
									</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{# Plan de maintenance — panel dédié, mis en valeur #}
				{% if task.planApplication %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-file-check"></i>
							{{ 'plan'|trans }}
						</div>
						{# Bouton explicite : le titre seul ne se lit pas comme cliquable #}
						<div class="d-flex align-items-start gap-2" style="margin-bottom:0.5rem;">
							<a href="{{ path('club_plan_application_show', {id: task.planApplication.id}) }}"
							   class="flex-fill"
							   style="font-weight:700;color:var(--td-deep);font-size:1rem;text-decoration:none;">
								{{ task.planApplication.plan.name }}
							</a>
							<a href="{{ path('club_plan_application_show', {id: task.planApplication.id}) }}"
								class="btn btn-sm btn-outline-primary flex-shrink-0"
								title="{{ 'viewPlan'|trans }}"
								aria-label="{{ 'viewPlan'|trans }}">
								<i class="ti ti-arrow-right"></i>
							</a>
						</div>
						<div class="text-secondary" style="font-size:0.82rem;">
							{% if task.planApplication.dueAt %}
								<div><i class="ti ti-calendar me-1"></i>{{ 'dueAt'|trans }} : {{ task.planApplication.dueAt|date('d/m/Y') }}</div>
							{% endif %}
							{% if task.planApplication.appliedBy %}
								<div class="mt-1"><i class="ti ti-user me-1"></i>{{ 'appliedBy'|trans }} : {{ task.planApplication.appliedBy.fullName }}</div>
							{% endif %}
						</div>
					</div>
				{% endif %}

				{# Anomalies traitées par cette tâche — une tâche peut en couvrir plusieurs #}
				{% if task.anomalies|length > 0 %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-alert-triangle"></i>
							{{ 'anomalies'|trans }}
							<span class="tarmac-section-bar__count">{{ task.anomalies|length }}</span>
						</div>
						<ul class="tarmac-meta-list">
							{% for anomaly in task.anomalies %}
								{% set anomalyStatus = anomaly.status %}
								<li style="display:block;">
									{# Bouton explicite : le titre seul ne se lit pas comme cliquable #}
									<div class="d-flex align-items-start gap-2">
										<a href="{{ path('club_anomaly_show', {id: anomaly.id}) }}"
											class="flex-fill"
											style="font-weight:600;color:var(--td-mid);text-decoration:none;">
											{{ anomaly.title }}
										</a>
										<a href="{{ path('club_anomaly_show', {id: anomaly.id}) }}"
											class="btn btn-sm btn-outline-primary flex-shrink-0"
											title="{{ 'viewAnomaly'|trans }}"
											aria-label="{{ 'viewAnomaly'|trans }}">
											<i class="ti ti-arrow-right"></i>
										</a>
									</div>
									<div class="tarmac-card__badges" style="margin-top:0.4rem;">
										<span class="tarmac-badge tarmac-badge--{{ anomalyStatus.color }}">
											<i class="ti {{ anomalyStatus.icon }}"></i>
											{{ anomalyStatus.label|trans }}
										</span>
										{% if anomaly.isGrounding %}
											<span class="tarmac-badge tarmac-badge--danger">
												<i class="ti {{ anomaly.impact.icon }}"></i>
												{{ anomaly.impact.label|trans }}
											</span>
										{% endif %}
									</div>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}
			</div>
		</div>

	</div>{# /row g-3 #}

	{# Cancel Modal #}
	<div class="modal fade" id="cancelModal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">{{ 'cancelTask'|trans }}</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<form method="post" action="{{ path('club_task_cancel', {id: task.id}) }}">
					<input type="hidden" name="activity_form[_token]" value="{{ csrf_token('activity_form') }}">
					<div class="modal-body">
						<div class="mb-3">
							<label class="form-label">{{ 'cancellationReason'|trans }}</label>
							<textarea name="activity_form[message]" class="form-control" rows="3" placeholder="{{ 'optionalReason'|trans }}"></textarea>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="min-height: 44px;">{{ 'cancel'|trans }}</button>
						<button type="submit" class="btn btn-danger" style="min-height: 44px;">{{ 'cancelTask'|trans }}</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
