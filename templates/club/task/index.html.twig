{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ 'tasks'|trans }}
{% endblock %}

{% block page_actions %}
	<a href="{{ path('club_task_new') }}" class="btn btn-primary">
		<i class="ti ti-plus me-2"></i>
		<span class="d-none d-sm-inline">{{ 'newTask'|trans }}</span>
		<span class="d-inline d-sm-none">{{ 'add'|trans }}</span>
	</a>
{% endblock %}

{% block page_content %}
	{% include 'component/filters.html.twig' with { form: filters } %}

	<div class="row">
		{% for task in tasks %}
			{% include 'component/taskCard.html.twig' with {'task': task} %}
		{% else %}
			<div class="col-12">
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-checklist"></i></div>
					<p class="text-secondary" style="margin:0 0 1rem;"><em>{{ 'noTasksFound'|trans }}</em></p>
					<a href="{{ path('club_task_new') }}" class="btn btn-primary">
						<i class="ti ti-plus me-2"></i>
						{{ 'newTask'|trans }}
					</a>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="d-flex justify-content-center mt-4">
		{{ pagination(tasks) }}
	</div>
{% endblock %}
