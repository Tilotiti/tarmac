{% extends 'club/base.html.twig' %}

{% block page_title %}
	{{ task.title }}
{% endblock %}

{% block page_pretitle %}
	<a href="{{ path('club_task_show', {id: task.id}) }}" class="tarmac-page-eyebrow">
		<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
			<i class="ti {{ task.equipment.type.icon }}"></i>
		</span>
		{{ task.equipment.name }} · {{ task.title }}
	</a>
{% endblock %}

{% block page_content %}
	<div class="row g-3">
		<div class="col-12 col-lg-8">
			<div class="tarmac-panel">
				<div class="tarmac-panel__title">
					<i class="ti ti-edit"></i>{{ 'edit'|trans }} {{ 'task'|trans|lower }}
				</div>

				<div class="mb-3">
					<label class="form-label">{{ 'equipment'|trans }}</label>
					<div class="form-control-plaintext">{{ task.equipment.name }}</div>
					<small class="form-text">{{ (task.equipment.type.value ~ 'Type')|trans }}</small>
				</div>

				{{ form_start(form) }}
				{{ form_row(form.title) }}
				{{ form_row(form.description) }}
				{% set taskDocumentationDeletePath = task.documentation ? path('club_task_delete_documentation', {id: task.id, _token: csrf_token('del_task_doc' ~ task.id)}) : null %}
				{% include 'component/documentationUploader.html.twig' with {
					field: form.documentation,
					existingUrl: task.documentation,
					deletePath: taskDocumentationDeletePath,
					deleteConfirmKey: 'confirmDeleteTaskDocumentation',
					lightboxGroup: 'task-documentation-' ~ task.id
				} %}
				{{ form_row(form.dueAt) }}

				<div class="d-flex justify-content-end gap-2 mt-3">
					<a href="{{ path('club_task_show', {id: task.id}) }}" class="btn btn-outline-secondary">{{ 'cancel'|trans }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="ti ti-check me-2"></i>{{ 'save'|trans }}
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>

		{% if task.planApplication %}
			<div class="col-12 col-lg-4">
				<div class="tarmac-panel">
					<div class="tarmac-panel__title">
						<i class="ti ti-clipboard-list"></i>{{ 'maintenancePlan'|trans }}
					</div>
					<div style="font-weight:700;color:var(--td-deep);margin-bottom:0.3rem;">
						{{ task.planApplication.plan.name }}
					</div>
					{% if task.planApplication.plan.description %}
						<div class="text-secondary" style="font-size:0.85rem;margin-bottom:0.6rem;">{{ task.planApplication.plan.description }}</div>
					{% endif %}
					<ul class="tarmac-meta-list">
						<li>
							<span class="tarmac-meta-list__label">{{ 'appliedOn'|trans }}</span>
							<span class="tarmac-meta-list__value">{{ task.planApplication.appliedAt|date('d/m/Y') }}</span>
						</li>
						{% if task.planApplication.dueAt %}
							<li>
								<span class="tarmac-meta-list__label">{{ 'planDueDate'|trans }}</span>
								<span class="tarmac-meta-list__value">{{ task.planApplication.dueAt|date('d/m/Y') }}</span>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
