{% extends 'club/base.html.twig' %}

{% block page_title %}
	{% if is_own_logbook %}
		{{ 'myMechanicLogbook'|trans }}
	{% else %}
		{{ membership.user.fullName }}
	{% endif %}
{% endblock %}

{% block page_header %}
	{# Breadcrumb spécifique (path différent pour own vs other) #}
	<ol class="tarmac-breadcrumb" aria-label="breadcrumbs">
		<li>
			<a href="{{ path('club_dashboard') }}" aria-label="{{ 'home'|trans }}">
				<i class="ti ti-home"></i>
			</a>
		</li>
		{% if is_own_logbook %}
			<li class="is-current">{{ 'myMechanicLogbook'|trans }}</li>
		{% else %}
			<li><a href="{{ path('club_members') }}">{{ 'members'|trans }}</a></li>
			<li><a href="{{ path('club_member_show', {id: membership.id}) }}">{{ membership.user.fullName }}</a></li>
			<li class="is-current">{{ 'mechanicLogbook'|trans }}</li>
		{% endif %}
	</ol>

	<div class="tarmac-page-eyebrow" style="cursor:default;">
		<span class="tarmac-eqv" style="background:var(--td-mid-soft);color:var(--td-mid);">
			<i class="ti ti-tools"></i>
		</span>
		{{ 'mechanicLogbook'|trans }}
	</div>

	<h2 class="page-title">
		{{ block('page_title') }}
	</h2>
{% endblock %}

{% block page_actions %}
	<a href="{{ path('club_member_logbook_pdf', {id: membership.id}) ~ (app.request.query.all ? '?' ~ app.request.query.all|url_encode : '') }}" class="btn btn-outline-secondary">
		<i class="ti ti-printer me-2"></i>
		<span class="d-none d-sm-inline">{{ 'exportPdf'|trans }}</span>
		<span class="d-inline d-sm-none">{{ 'pdf'|trans }}</span>
	</a>
{% endblock %}

{% block page_content %}
	{# Helper : total heures globales en h/m #}
	{% set totalMinutes = (facets.global.time * 60)|round(0, 'floor') %}
	{% set totalHours = (totalMinutes / 60)|round(0, 'floor') %}
	{% set totalMin = totalMinutes - (totalHours * 60) %}

	{# KPI strip #}
	<div class="row g-2 mb-4">
		<div class="col-6 col-md-4">
			<div class="tarmac-kpi tarmac-kpi--glow">
				<span class="tarmac-kpi__icon"><i class="ti ti-clock-hour-5"></i></span>
				<div class="tarmac-kpi__label">{{ 'totalTime'|trans }}</div>
				<div class="tarmac-kpi__value">
					{{ totalHours }}<span style="font-size:0.6em;font-weight:600;color:var(--td-ink-3);">h</span>{% if totalMin > 0 %}{{ totalMin }}<span style="font-size:0.6em;font-weight:600;color:var(--td-ink-3);">m</span>{% endif %}
				</div>
			</div>
		</div>
		<div class="col-6 col-md-4">
			<div class="tarmac-kpi">
				<span class="tarmac-kpi__icon"><i class="ti ti-list-check"></i></span>
				<div class="tarmac-kpi__label">{{ 'contributionsCount'|trans|capitalize }}</div>
				<div class="tarmac-kpi__value">{{ facets.global.count }}</div>
			</div>
		</div>
		<div class="col-12 col-md-4">
			<div class="tarmac-kpi tarmac-kpi--purple">
				<span class="tarmac-kpi__icon"><i class="ti ti-tag"></i></span>
				<div class="tarmac-kpi__label">{{ 'specialisations'|trans }}</div>
				<div class="tarmac-kpi__value">{{ facets.bySpecialisation|length }}</div>
			</div>
		</div>
	</div>

	<div class="row g-3">

		{# ========== Colonne principale ========== #}
		<div class="col-12 col-lg-8">

			{# Filtres #}
			{% include 'component/filters.html.twig' with { form: filters } %}

			{# Liste des contributions #}
			<div class="tarmac-section-bar">
				<h3 class="tarmac-section-bar__title">
					<i class="ti ti-history"></i>
					{{ 'contributionsList'|trans }}
					<span class="tarmac-section-bar__count">{{ facets.global.count }}</span>
				</h3>
			</div>

			{% if contributions|length > 0 %}
				<div class="row">
					{% for contribution in contributions %}
						{% set subTask = contribution.subTask %}
						{% set task = subTask.task %}
						{% set isCancelled = subTask.status == 'cancelled' %}
						<div class="col-12 col-lg-6 mb-3 d-flex">
							<a href="{{ path('club_subtask_show', {taskId: task.id, id: subTask.id}) }}"
							   class="tarmac-card w-100{% if isCancelled %} tarmac-card--dimmed{% endif %}">

								<div class="tarmac-card__head">
									<span class="tarmac-eqv tarmac-eqv--{{ task.equipment.type.color }}">
										<i class="ti {{ task.equipment.type.icon }}"></i>
									</span>
									<div class="flex-fill">
										<div class="tarmac-card__eyebrow">{{ task.equipment.name }} · {{ task.title }}</div>
										<h3 class="tarmac-card__title">{{ subTask.title }}</h3>

										<div class="tarmac-card__badges">
											{# Statut explicite — premier badge #}
											{% if subTask.isWaitingForApproval %}
												<span class="tarmac-badge tarmac-badge--status-inspection">
													<i class="ti ti-hourglass"></i>{{ 'statusDonePendingLabel'|trans }}
												</span>
											{% elseif subTask.status == 'closed' %}
												<span class="tarmac-badge tarmac-badge--status-closed">
													<i class="ti ti-circle-check"></i>{{ 'statusClosedLabel'|trans }}
												</span>
											{% elseif subTask.status == 'cancelled' %}
												<span class="tarmac-badge tarmac-badge--status-cancelled">
													<i class="ti ti-x"></i>{{ 'statusCancelledLabel'|trans }}
												</span>
											{% else %}
												<span class="tarmac-badge tarmac-badge--status-open">
													<i class="ti ti-circle"></i>{{ 'statusOpenLabel'|trans }}
												</span>
											{% endif %}

											{# Signature #}
											{% if subTask.completedBy %}
												<span class="tarmac-badge tarmac-badge--success">
													<i class="ti ti-signature"></i>{{ 'signedBy'|trans }} {{ subTask.completedBy.fullName ?? subTask.completedBy.email }}
												</span>
											{% else %}
												<span class="tarmac-badge tarmac-badge--secondary">
													<i class="ti ti-signature-off"></i>{{ 'notSigned'|trans }}
												</span>
											{% endif %}

											{# Spécialisations #}
											{% for specialisation in subTask.specialisations %}
												<span class="tarmac-badge tarmac-badge--specialisation">
													<i class="ti ti-tag"></i>{{ specialisation.name }}
												</span>
											{% endfor %}
										</div>
									</div>
								</div>

								{# Footer : temps + date #}
								<div class="tarmac-card__footer d-flex align-items-center justify-content-between gap-2">
									<span class="tarmac-card__meta">
										<i class="ti ti-calendar"></i>
										{{ contribution.createdAt|date('d/m/Y H:i') }}
									</span>
									<span style="font-weight:700;color:var(--td-deep);font-size:0.95rem;">
										<i class="ti ti-clock-hour-5 me-1" style="color:var(--td-ink-3);"></i>
										{{ contribution.timeSpent|number_format(2, ',', ' ') }}
										<span style="font-size:0.78rem;font-weight:500;color:var(--td-ink-3);">{{ 'hours'|trans }}</span>
									</span>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>

				<div class="d-flex justify-content-center mt-3">
					{{ pagination(contributions) }}
				</div>
			{% else %}
				<div class="tarmac-panel" style="text-align:center;padding:2.5rem 1.5rem;">
					<div style="font-size:2.5rem;color:var(--td-ink-3);margin-bottom:0.75rem;"><i class="ti ti-history-off"></i></div>
					<p class="text-secondary" style="margin:0;"><em>{{ 'noContributionsFound'|trans }}</em></p>
				</div>
			{% endif %}

		</div>{# /col-12 col-lg-8 (main) #}

		{# ========== Sidebar ========== #}
		<div class="col-12 col-lg-4">
			<div class="tarmac-page-sidebar">

				{# Panel : répartition par spécialisation #}
				{% if facets.bySpecialisation is not empty %}
					<div class="tarmac-panel">
						<div class="tarmac-panel__title">
							<i class="ti ti-chart-pie"></i>
							{{ 'distributionBySpecialisation'|trans }}
						</div>
						<ul class="tarmac-spec-list">
							{% set totalTime = facets.global.time > 0 ? facets.global.time : 1 %}
							{% for row in facets.bySpecialisation %}
								{% set ratio = (row.time / totalTime * 100)|round(0, 'floor') %}
								{% set rowMinutes = (row.time * 60)|round(0, 'floor') %}
								{% set rowHours = (rowMinutes / 60)|round(0, 'floor') %}
								{% set rowMin = rowMinutes - (rowHours * 60) %}
								<li class="tarmac-spec-list__item">
									<div class="tarmac-spec-list__head">
										<span class="tarmac-spec-list__name">{{ row.specialisation.name }}</span>
										<span class="tarmac-spec-list__time">
											{{ rowHours }}h{% if rowMin > 0 %}{{ rowMin }}{% endif %} · {{ ratio }}%
										</span>
									</div>
									<div class="tarmac-progress">
										<span style="width: {{ ratio }}%"></span>
									</div>
									<div class="tarmac-spec-list__count">{{ row.count }} {{ 'contributionsCount'|trans }}</div>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

			</div>
		</div>

	</div>{# /row g-3 #}
{% endblock %}
