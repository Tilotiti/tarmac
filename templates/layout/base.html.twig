<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Accueil
			{% endblock %}
			- Tarmac
		</title>
		<link rel="icon" href="{{ asset('glider.svg') }}" type="image/svg+xml">
		<link rel="apple-touch-icon" href="{{ asset('glider.svg') }}">
		<link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
		<meta name="theme-color" content="#345B7C">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@latest/dist/css/tabler.min.css"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"/>
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{% block importmap %}
			{{ importmap('app') }}
		{% endblock %}
	</head>
	<body data-controller="confirm">
		<div class="page{% block page_class %}{% endblock %}">
			{% block header %}
				{# Le header est rendu pour tout le monde : sans lui, un visiteur anonyme
				   se retrouve sur une page sans repère ni moyen de naviguer. #}
				{# Les pages publiques n'ont pas de menu : pas de hamburger qui ouvrirait
				   un panneau vide. #}
				{% set navbarMenu = block('navbar_menu')|trim %}
				<header class="navbar navbar-expand-md d-print-none{% block header_class %}{% endblock %}" style="min-height: 3.25rem;">
					<div class="container-xl">
						{% if navbarMenu is not empty %}
							<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation" style="min-height: 44px; min-width: 44px;">
								<span class="navbar-toggler-icon"></span>
							</button>
						{% endif %}
						<div class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal p-0 m-0 me-3 me-md-4">
							{% block navbar_brand %}
								{% include 'component/brandMark.html.twig' %}
							{% endblock %}
						</div>
						{# ms-auto sous md : sans lui les actions flottent au milieu de la barre #}
						<div class="navbar-nav flex-row order-md-last align-items-center ms-auto ms-md-0">
						{% if not app.user %}
							{% block anonymous_actions %}
								<a href="{{ path('public_guide') }}" class="nav-link px-2 me-1" title="{{ 'userGuide'|trans }}" style="min-height: 44px;">
									<span class="nav-link-icon d-md-none d-lg-inline-block">
										<i class="ti ti-book-2"></i>
									</span>
									{# Libellé masqué sous 576px : sinon le header passe sur deux lignes #}
									<span class="nav-link-title d-none d-sm-inline">{{ 'userGuide'|trans }}</span>
								</a>
								<a href="{{ path('public_login') }}" class="btn btn-primary" style="min-height: 44px;">
									<i class="ti ti-login me-2"></i>
									{{ 'signIn'|trans }}
								</a>
							{% endblock %}
						{% else %}
							{% block user_dropdown %}
								<div class="nav-item dropdown" data-controller="dropdown">
									<a href="#" class="tarmac-user-toggle" data-dropdown-target="toggle" aria-label="Ouvrir le menu utilisateur" aria-expanded="false">
										<span class="avatar">{{ app.user.firstname[:1] }}{{ app.user.lastname[:1] }}</span>
										<span class="tarmac-user-toggle__name">{{ app.user.firstname|default(app.user.fullName) }}</span>
										<i class="ti ti-chevron-down tarmac-user-toggle__chevron"></i>
									</a>
									<div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow" data-dropdown-target="menu" style="min-width:240px;">
										<div class="tarmac-dropdown-header">
											<div class="tarmac-dropdown-header__name">{{ app.user.fullName|default('Utilisateur') }}</div>
											<div class="tarmac-dropdown-header__email">{{ app.user.email }}</div>
											{% block user_dropdown_subtitle %}{% endblock %}
										</div>

										{% block user_dropdown_menu %}
											<a href="{{ path('public_profile_edit') }}" class="dropdown-item">
												<i class="ti ti-user me-2"></i>
												{{ 'myProfile'|trans }}
											</a>
											<a href="{{ path('public_guide') }}" class="dropdown-item">
												<i class="ti ti-book-2 me-2"></i>
												{{ 'userGuide'|trans }}
											</a>
											{% if is_granted('ROLE_ADMIN') %}
												<div class="dropdown-divider"></div>
												<a href="{{ path('admin_dashboard') }}" class="dropdown-item">
													<i class="ti ti-shield me-2"></i>
													{{ 'administration'|trans }}
												</a>
											{% endif %}
											<div class="dropdown-divider"></div>
											<a href="{{ path('public_logout') }}" class="dropdown-item">
												<i class="ti ti-logout me-2"></i>
												{{ 'logout'|trans }}
											</a>
										{% endblock %}
									</div>
								</div>
							{% endblock %}
						{% endif %}
						</div>
						{% if navbarMenu is not empty %}
							<div class="collapse navbar-collapse" id="navbar-menu">
								<div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
									{% block navbar_menu %}{% endblock %}
								</div>
							</div>
						{% endif %}
					</div>
				</header>
			{% endblock %}

				<main class="page-wrapper">
					<div class="page-body">
						<div class="container-xl">
							{% for label, messages in app.flashes %}
								{% for message in messages %}
									<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
										<div class="d-flex">
											<div>
												<i class="ti ti-{{ label == 'success' ? 'check' : label == 'warning' ? 'alert-triangle' : label == 'danger' ? 'alert-circle' : 'info-circle' }} me-2"></i>
											</div>
											<div>
												{{ message|trans }}
											</div>
										</div>
										<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'close'|trans }}"></button>
									</div>
								{% endfor %}
							{% endfor %}

							{% block body %}{% endblock %}
						</div>
					</div>
				</main>

				{% block footer %}
					<footer class="footer footer-transparent d-print-none mt-auto">
						<div class="container-xl">
							<div class="row text-center align-items-center">
								<div class="col-12 col-lg-auto">
									<ul class="list-inline list-inline-dots mb-0">
										<li class="list-inline-item">
											<small class="text-muted">
												© 2025 Thibault HENRY
											</small>
										</li>
										<li class="list-inline-item">
											<a href="mailto:contact@tarmac.center" class="link-secondary text-decoration-none">
												<small>
													<i class="ti ti-help-circle me-1"></i>
													{{ 'needHelp'|trans }}
												</small>
											</a>
										</li>
									</ul>
								</div>
							</div>
						</div>
					</footer>
				{% endblock %}
			</div>

			{% block javascripts %}{% endblock %}
		</body>
	</html>
